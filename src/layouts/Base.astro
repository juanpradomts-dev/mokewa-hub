---
import "@fontsource-variable/archivo/wdth.css";
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import BotonContacto from "../components/BotonContacto.astro";
import club from "../data/club.json";
import { MODO, esProduccion, valor } from "../lib/contenido.js";
import { LEMA, NOMBRE } from "../lib/club.js";
import { FACEBOOK } from "../lib/contacto.js";
import { hayBaseDeDatos } from "../lib/backend.js";

interface Props {
  titulo: string;
  descripcion?: string;
  seccion?: string;
  sinWhatsapp?: boolean;
  privada?: boolean; // nunca se indexa (panel, 404)
}
const { titulo, descripcion = "Ajedrez Club Mokewa, Moquegua: academia por niveles, torneos, resultados y la historia del club desde 2020.", seccion = "", sinWhatsapp = false, privada = false } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (p: string) => `${b}${p}`;
// Menú de 4 + botón de contacto. El inicio se alcanza con el logo.
const enlaces = [
  ["academia", "/academia/", "Academia"],
  ["torneos", "/torneos/", "Torneos"],
  ["club", "/el-club/", "El Club"],
  ["contacto", "/contacto/", "Contacto"],
];
// Indexación: la demo nunca se indexa (guía, 10.2). En producción sí, salvo las páginas privadas.
const indexable = esProduccion && !privada;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
// Ficha del club para Google (solo producción y solo en el inicio), con datos verificados o confirmados.
const whatsapp = valor("whatsapp");
const fichaClub = indexable && seccion === "inicio"
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SportsClub",
      name: NOMBRE,
      slogan: LEMA,
      sport: "Ajedrez",
      url: new URL(`${b}/`, Astro.site).href,
      logo: new URL(`${b}/icono-512.png`, Astro.site).href,
      image: new URL(`${b}/og.png`, Astro.site).href,
      address: { "@type": "PostalAddress", addressLocality: "Moquegua", addressCountry: "PE", ...(valor("sede") ? { streetAddress: valor("sede") } : {}) },
      ...(whatsapp ? { telephone: `+${whatsapp}` } : {}),
      ...(valor("correo") ? { email: valor("correo") } : {}),
      sameAs: [FACEBOOK, club.equipo.url],
    })
  : null;
const tituloCompleto = seccion === "inicio" ? `Ajedrez Club Mokewa · ${LEMA}` : `${titulo} · Ajedrez Club Mokewa`;
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Demo privada: no se indexa hasta que el club apruebe la web (guía, sección 10.2). -->
    <meta name="robots" content={indexable ? "index, follow" : "noindex, nofollow"} />
    {indexable && <link rel="canonical" href={canonica} />}
    {indexable && <meta property="og:url" content={canonica} />}
    {fichaClub && <script type="application/ld+json" set:html={fichaClub} />}
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#f28a1e" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="manifest" href={url("/manifest.webmanifest")} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ajedrez Club Mokewa" />
    <meta property="og:image" content={new URL(`${b}/og.png`, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Insignia del Ajedrez Club Mokewa: caballo negro con corona naranja" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <meta name="color-scheme" content="light" />
    <slot name="head" />
  </head>
  <body data-base={b} data-modo={MODO}>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    {!esProduccion && (
      <div class="aviso-demo">
        Demostración privada preparada para el Ajedrez Club Mokewa · aún no es la web oficial ·{" "}
        <a href={url("/acerca-de-la-demo/")}>qué es esto</a>
      </div>
    )}
    <header class="cabecera">
      <div class="contenedor">
        <a class="marca" href={url("/")}>
          <Logo tam={40} />
          <span class="marca-texto"><strong>Ajedrez Club Mokewa</strong></span>
        </a>
        <nav class="nav" aria-label="Principal">
          {enlaces.map(([id, href, texto]) => <a href={url(href)} aria-current={seccion === id ? "page" : undefined}>{texto}</a>)}
        </nav>
        <BotonContacto cta clase="boton-chico cta-cabecera" />
        <button class="boton-menu" type="button" aria-expanded="false" aria-controls="menu-movil" aria-label="Abrir menú">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
        </button>
      </div>
      <nav class="menu-movil" id="menu-movil" aria-label="Principal (móvil)">
        {enlaces.map(([id, href, texto]) => <a href={url(href)} aria-current={seccion === id ? "page" : undefined}>{texto}</a>)}
        <div class="menu-movil-cta"><BotonContacto cta /></div>
      </nav>
    </header>

    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    {!sinWhatsapp && <BotonContacto variante="flotante" mensaje="Hola, quisiera información sobre el Ajedrez Club Mokewa." />}

    <footer class="pie">
      <div class="contenedor">
        <div class:list={["rejilla", esProduccion ? "rejilla-2" : "rejilla-3"]}>
          <div>
            <h3>Ajedrez Club Mokewa</h3>
            <p>Academia por niveles, torneos presenciales y una comunidad que sigue jugando en línea.</p>
            <p>
              <a href="https://www.facebook.com/ACMokewa/" rel="noopener" target="_blank">Facebook</a> ·{" "}
              <a href={club.equipo.url} rel="noopener" target="_blank">Equipo en Lichess</a>
            </p>
          </div>
          <div>
            <h3>Explorar</h3>
            <ul>
              <li><a href={url("/academia/")}>Academia</a></li>
              <li><a href={url("/torneos/")}>Torneos y resultados</a></li>
              <li><a href={url("/el-club/")}>Historia del club</a></li>
              <li><a href={url("/el-club/#comunidad")}>Comunidad en Lichess</a></li>
              <li><a href={url("/contacto/")}>Contacto</a></li>
              <li><a href={url("/privacidad/")}>Privacidad y datos de menores</a></li>
              {(!esProduccion || hayBaseDeDatos) && <li><a href={url("/panel/")}>Iniciar sesión (personal del club)</a></li>}
            </ul>
          </div>
          {!esProduccion && (
            <div class="pie-datos">
              <h3>Esta demo</h3>
              <p>Lo que el club aún no confirmó aparece marcado <span class="pc">por confirmar</span> y se completa desde el panel.</p>
            </div>
          )}
        </div>
        {!esProduccion && <p class="legal">
          Demostración privada, no indexada, preparada sin costo para el club. No se difunde ni se presenta como web oficial hasta que el Ajedrez Club Mokewa la apruebe. De los campeones solo muestra el nombre y la inicial del apellido; ninguna foto de alumnos.
        </p>}
      </div>
    </footer>

    <script>
      import { pintarCampos, alCambiar } from "../lib/store.js";
      pintarCampos();
      alCambiar(() => pintarCampos());

      const boton = document.querySelector(".boton-menu");
      const menu = document.getElementById("menu-movil");
      boton?.addEventListener("click", () => {
        const abierto = menu?.classList.toggle("abierto");
        boton.setAttribute("aria-expanded", String(!!abierto));
        boton.setAttribute("aria-label", abierto ? "Cerrar menú" : "Abrir menú");
      });
    </script>
  </body>
</html>
