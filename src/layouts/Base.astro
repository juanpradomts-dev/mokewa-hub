---
import "@fontsource-variable/archivo/wdth.css";
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import Redes from "../components/Redes.astro";
import club from "../data/club.json";
import { MODO, esProduccion, indexar, valor } from "../lib/contenido.js";
import { LEMA, NOMBRE } from "../lib/club.js";
import { hayBaseDeDatos } from "../lib/backend.js";
import { FACEBOOK, enlaceContacto, numeroWhatsapp } from "../lib/contacto.js";

interface Props {
  titulo: string;
  descripcion?: string;
  seccion?: string;
  privada?: boolean; // nunca se indexa (panel, 404)
}
const { titulo, descripcion = "Ajedrez Club Mokewa, Moquegua: academia de ajedrez, torneos presenciales y la historia de sus campeones.", seccion = "", privada = false } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (p: string) => `${b}${p}`;
// Menú de 4 + botón de contacto. El inicio se alcanza con el logo.
const enlaces = [
  ["academia", "/academia/", "Academia"],
  ["torneos", "/torneos/", "Torneos"],
  ["club", "/el-club/", "El Club"],
  ["contacto", "/contacto/", "Contacto"],
];
// Indexación: la demo nunca se indexa (guía, 10.2). La web oficial sí (salvo PUBLIC_INDEXAR=no y las páginas privadas).
const indexable = indexar && !privada;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
// Ficha del club para Google (solo producción y solo en el inicio), con datos verificados o confirmados.
const whatsapp = valor("whatsapp");
const fichaClub = indexable && seccion === "inicio"
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SportsClub",
      name: NOMBRE,
      slogan: LEMA,
      sport: "Ajedrez",
      url: new URL(`${b}/`, Astro.site).href,
      logo: new URL(`${b}/icono-512.png`, Astro.site).href,
      image: new URL(`${b}/og.png`, Astro.site).href,
      address: { "@type": "PostalAddress", addressLocality: "Moquegua", addressCountry: "PE", ...(valor("sede") ? { streetAddress: valor("sede") } : {}) },
      ...(whatsapp ? { telephone: `+${whatsapp}` } : {}),
      ...(valor("correo") ? { email: valor("correo") } : {}),
      sameAs: [FACEBOOK, club.equipo.url, ...["instagram", "tiktok", "youtube"].map((c) => valor(c)).filter((v): v is string => !!v && v.startsWith("https://"))],
    })
  : null;
// «Iniciar sesión» (personal del club) va en la cabecera; sin base de datos, la web oficial no tiene panel.
const acceso = !esProduccion || hayBaseDeDatos;
const numeroWsp = numeroWhatsapp(valor("whatsapp"));
const MENSAJE_WSP = "Hola, quisiera información sobre el Ajedrez Club Mokewa.";
// Mientras no haya WhatsApp, el globo ofrece el canal que sí funciona: Gmail o, si falta, Facebook.
const alterno = enlaceContacto({ correo: valor("correo") }, MENSAJE_WSP);
const LOGO_WSP = "M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7c.1.2 1.9 2.9 4.6 4 1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.4-.3Z";
const tituloCompleto = seccion === "inicio" ? `Ajedrez Club Mokewa · ${LEMA}` : `${titulo} · Ajedrez Club Mokewa`;
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={indexable ? "index, follow" : "noindex, nofollow"} />
    {indexable && <link rel="canonical" href={canonica} />}
    {indexable && <meta property="og:url" content={canonica} />}
    {fichaClub && <script type="application/ld+json" set:html={fichaClub} />}
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#f28a1e" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="manifest" href={url("/manifest.webmanifest")} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ajedrez Club Mokewa" />
    <meta property="og:image" content={new URL(`${b}/og.png`, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Insignia del Ajedrez Club Mokewa: caballo negro con corona naranja" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <meta name="color-scheme" content="light" />
    <slot name="head" />
    <script is:inline>
      // Aparición escalonada de tarjetas: solo si el navegador sabe observarlas (si no, todo visible)
      if ("IntersectionObserver" in window) document.documentElement.classList.add("con-aparicion");
    </script>
  </head>
  <body data-base={b} data-modo={MODO}>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    {!esProduccion && (
      <div class="aviso-demo">
        Demostración privada preparada para el Ajedrez Club Mokewa · aún no es la web oficial ·{" "}
        <a href={url("/acerca-de-la-demo/")}>qué es esto</a>
      </div>
    )}
    <header class="cabecera">
      <div class="contenedor">
        <a class="marca" href={url("/")}>
          <Logo tam={40} />
          <span class="marca-texto"><strong>Ajedrez Club Mokewa</strong></span>
        </a>
        <nav class="nav" aria-label="Principal">
          {enlaces.map(([id, href, texto]) => <a href={url(href)} aria-current={seccion === id ? "page" : undefined}>{texto}</a>)}
        </nav>
        {acceso && (
          <a class="acceso-cabecera" href={url("/panel/")} aria-current={seccion === "panel" ? "page" : undefined}>
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0"></path></svg>
            Iniciar sesión
          </a>
        )}
        <button class="boton-menu" type="button" aria-expanded="false" aria-controls="menu-movil" aria-label="Abrir menú">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
        </button>
      </div>
      <nav class="menu-movil" id="menu-movil" aria-label="Principal (móvil)">
        {enlaces.map(([id, href, texto]) => <a href={url(href)} aria-current={seccion === id ? "page" : undefined}>{texto}</a>)}
        {acceso && <a href={url("/panel/")} aria-current={seccion === "panel" ? "page" : undefined}>Iniciar sesión</a>}
      </nav>
    </header>

    <main id="contenido" tabindex="-1">
      <slot />
    </main>


    <!-- Un solo botón flotante: WhatsApp del club, en todas las páginas. Con número abre el chat; sin
         número, un globo avisa que llega pronto y ofrece el canal que sí funciona (Gmail o Facebook). -->
    <div class="wsp" data-wsp-caja>
      <a class="wsp-boton" data-wsp data-si-campos="whatsapp" hidden={!numeroWsp} href={numeroWsp ? `https://wa.me/${numeroWsp}?text=${encodeURIComponent(MENSAJE_WSP)}` : "#"} data-mensaje={MENSAJE_WSP} rel="noopener" target="_blank" aria-label="Abrir el WhatsApp del club">
        <svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={LOGO_WSP}></path></svg>
      </a>
      <button class="wsp-boton" type="button" data-sin-campo="whatsapp" hidden={!!numeroWsp} aria-expanded="false" aria-controls="wsp-aviso" aria-label="WhatsApp del club">
        <svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={LOGO_WSP}></path></svg>
      </button>
      <div class="wsp-aviso" id="wsp-aviso" hidden>
        {esProduccion ? (
          <p><strong>WhatsApp del club</strong><br />Muy pronto podrás escribirnos por aquí.</p>
        ) : (
          <>
            <p><strong>WhatsApp del club:</strong> <span class="pc">por confirmar</span></p>
            <p>Cuando el club lo cargue en el panel, este botón abrirá el chat.</p>
          </>
        )}
        <a href={alterno.href} data-alterno data-mensaje={MENSAJE_WSP} rel="noopener" target="_blank">Mientras tanto, envíanos un mensaje</a>
      </div>
    </div>
    <footer class="pie">
      <div class="contenedor">
        <div class="pie-fila">
          <p class="pie-marca"><strong>Ajedrez Club Mokewa</strong> <span>{LEMA}</span></p>
          <ul class="pie-nav" aria-label="Enlaces del pie">
            <li><a href={url("/academia/")}>Academia</a></li>
            <li><a href={url("/torneos/")}>Torneos</a></li>
            <li><a href={url("/el-club/#historia")}>Campeones</a></li>
            <li><a href={url("/contacto/")}>Contacto</a></li>
            <li><a href={url("/privacidad/")}>Privacidad</a></li>
          </ul>
          <Redes variante="pie" />
        </div>
        {!esProduccion && <p class="legal">
          Demo privada, no indexada, sin costo para el club; no es la web oficial hasta que el club la apruebe. Lo marcado <span class="pc">por confirmar</span> se completa desde el panel. De los campeones solo se muestra el nombre y la inicial del apellido.
        </p>}
      </div>
    </footer>

    <script>
      import { pintarCampos, alCambiar, contenido } from "../lib/store.js";
      import { enlaceContacto } from "../lib/contacto.js";
      const alterno = document.querySelector<HTMLAnchorElement>("[data-alterno]");
      const pintar = () => {
        pintarCampos();
        if (alterno) alterno.href = enlaceContacto({ correo: contenido("correo") }, alterno.dataset.mensaje).href;
      };
      pintar();
      alCambiar(pintar);

      // Las tarjetas marcadas con data-aparece se funden al entrar en pantalla, una sola vez
      const aparecer = document.querySelectorAll<HTMLElement>("[data-aparece]");
      if ("IntersectionObserver" in window) {
        const vista = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("visto");
              vista.unobserve(e.target);
            }
          },
          { rootMargin: "0px 0px -6% 0px", threshold: 0.12 },
        );
        aparecer.forEach((el) => vista.observe(el));
      }

      const boton = document.querySelector(".boton-menu");
      const menu = document.getElementById("menu-movil");
      boton?.addEventListener("click", () => {
        const abierto = menu?.classList.toggle("abierto");
        boton.setAttribute("aria-expanded", String(!!abierto));
        boton.setAttribute("aria-label", abierto ? "Cerrar menú" : "Abrir menú");
      });

      // Botón de WhatsApp sin número: abre y cierra el globo «muy pronto».
      const wsp = document.querySelector<HTMLButtonElement>("[data-wsp-caja] button");
      const aviso = document.getElementById("wsp-aviso");
      const cerrarAviso = () => {
        if (!aviso || aviso.hidden) return;
        aviso.hidden = true;
        wsp?.setAttribute("aria-expanded", "false");
      };
      wsp?.addEventListener("click", (e) => {
        e.stopPropagation();
        const abrir = aviso!.hidden;
        aviso!.hidden = !abrir;
        wsp.setAttribute("aria-expanded", String(abrir));
      });
      document.addEventListener("click", (e) => {
        if (!(e.target as HTMLElement).closest("#wsp-aviso")) cerrarAviso();
      });
      document.addEventListener("keydown", (e) => e.key === "Escape" && cerrarAviso());
    </script>
  </body>
</html>
