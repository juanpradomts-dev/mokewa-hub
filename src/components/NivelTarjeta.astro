---
// Tarjeta de un nivel de la academia.
// Si el horario o el precio no están confirmados, en vez de repetir «por confirmar» muestra
// UN solo botón, con texto propio en cada nivel («Quiero empezar»…). Cuando el club los carga (panel o contenido.json), aparecen.
import Dato from "./Dato.astro";
import { svgPieza } from "../lib/piezas.js";
import BotonContacto from "./BotonContacto.astro";
import contenido from "../data/contenido.json";
import { valor, lista, esProduccion } from "../lib/contenido.js";

interface Props {
  nivel: { id: string; nombre: string; pieza: string; horario: string; edad: string; para: string; accion: string };
  orden?: number; // posición en la fila: escalona la aparición
  titulo?: "h2" | "h3";
}
const { nivel: n, titulo = "h3", orden = 0 } = Astro.props;
const Titulo = titulo;
const hayHorario = !!(valor(n.horario) && valor("precio_mensual"));
// Qué aprende: lo confirmado por el club; si no, en la demo la propuesta (marcada) y en producción nada.
const campoAprende = `aprende_${n.id}`;
const propuesta = ((contenido.campos as Record<string, { propuesta?: string }>)[campoAprende]?.propuesta ?? "").split("\n").filter(Boolean);
const confirmado = lista(campoAprende);
const aprende = confirmado.length ? confirmado : esProduccion ? [] : propuesta;
const mensaje = `Hola, quisiera saber el horario y el precio del nivel ${n.nombre.toLowerCase()} de la academia.`;
---

<article class={`tarjeta nivel nivel-${n.id}`} id={n.id} data-aparece style={`--i:${orden}`}>
  <!-- La pieza del nivel sobre su casilla: el tablero se oscurece de básico a avanzado -->
  <div class="nivel-casilla" aria-hidden="true">
    <span class="nivel-pieza" set:html={svgPieza(n.pieza, "claro")} />
  </div>
  <div class="nivel-cabeza">
    <Titulo class="nivel-nombre">{n.nombre}</Titulo>
    <Dato clase="nivel-edad" etiqueta="Edad sugerida" campo={n.edad} />
  </div>
  <p class="nivel-para">{n.para}</p>
  {aprende.length > 0 && (
    <ul class="nivel-aprende" data-lista={campoAprende} data-propuesta={esProduccion ? undefined : propuesta.join("\n")}>
      {aprende.map((a) => <li>{a}</li>)}
    </ul>
  )}
  {!confirmado.length && !esProduccion && <span class="chip-propuesta" data-sin-campo={campoAprende}>Temas: propuesta · por confirmar</span>}
  <div class="nivel-pie">
    <div class="nivel-horario" data-si-campos={`${n.horario} precio_mensual`} hidden={!hayHorario}>
      <Dato etiqueta="Horario" campo={n.horario} />
      <Dato etiqueta="Mensualidad" campo="precio_mensual" />
    </div>
    <BotonContacto
      variante="secundario"
      accion={hayHorario ? `Inscribirme en ${n.nombre}` : n.accion}
      mensaje={mensaje}
      clase="nivel-boton"
      data-segun={`${n.horario} precio_mensual`}
      data-accion-con={`Inscribirme en ${n.nombre}`}
      data-accion-sin={n.accion}
    />
  </div>
</article>

<style>
  .nivel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0 24px 24px;
    overflow: hidden;
    scroll-margin-top: 90px;
  }
  /* Casilla de tablero (4 cuadros por fila) con la pieza al centro */
  .nivel-casilla {
    display: grid;
    place-items: center;
    height: 132px;
    margin: 0 -24px 6px;
    background: repeating-conic-gradient(var(--casilla-a) 0 25%, var(--casilla-b) 0 50%) 50% 50% / 66px 66px;
  }
  .nivel-pieza {
    display: block;
    font-size: 5.2rem;
    line-height: 0;
    color: var(--tinta);
    filter: drop-shadow(0 8px 10px rgb(60 25 4 / 0.28));
    transition: transform var(--t-medio) var(--curva-resorte);
  }
  .nivel:hover .nivel-pieza {
    transform: translateY(-4px);
  }
  /* Al aparecer la tarjeta, la pieza cae sobre su casilla (un solo movimiento, para todos) */
  :global(.con-aparicion) .nivel[data-aparece] .nivel-pieza {
    opacity: 0;
    transform: translateY(-26px) scale(1.06);
    transition:
      opacity 0.3s var(--curva),
      transform 0.65s var(--curva-resorte);
    transition-delay: calc(var(--i, 0) * 70ms + 220ms);
  }
  :global(.con-aparicion) .nivel.visto .nivel-pieza {
    opacity: 1;
    transform: none;
  }
  :global(.con-aparicion) .nivel.visto:hover .nivel-pieza {
    transform: translateY(-4px);
    transition-delay: 0s;
  }
  .nivel-cabeza {
    display: grid;
    gap: 2px;
  }
  .nivel-nombre {
    font-size: clamp(1.45rem, 2.4vw, 1.75rem);
    margin: 0;
  }
  .nivel-para {
    margin: 0;
    color: var(--suave);
  }
  .nivel-aprende {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
    font-size: 0.97rem;
  }
  /* :global porque el panel de la demo reescribe estos <li> en vivo (store.js) */
  .nivel-aprende :global(li) {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 8px;
  }
  /* Viñeta: una casilla de tablero */
  .nivel-aprende :global(li)::before {
    content: "";
    width: 7px;
    height: 7px;
    margin-top: 0.6em;
    background: var(--acento-nivel, var(--oro));
  }
  .nivel-pie {
    margin-top: auto;
    display: grid;
    gap: 12px;
    padding-top: 6px;
  }
  .nivel-horario {
    display: grid;
    gap: 4px;
  }
  .nivel-horario[hidden] {
    display: none;
  }
  .nivel-pie :global(.nivel-boton) {
    width: 100%;
  }
  /* De básico a avanzado el tablero se oscurece y la pieza sube de rango: peón blanco, caballo blanco, dama dorada */
  .nivel-basico {
    --acento-nivel: #f7a54a;
    --casilla-a: #fff1e0;
    --casilla-b: #fde2c6;
  }
  .nivel-intermedio {
    --acento-nivel: #f28a1e;
    --casilla-a: #f7a54a;
    --casilla-b: #f28a1e;
  }
  .nivel-avanzado {
    --acento-nivel: #a64b08;
    --casilla-a: #5a2a06;
    --casilla-b: #6e3510;
  }
  .nivel-avanzado .nivel-pieza {
    --pr: #f7a54a;
    filter: drop-shadow(0 8px 12px rgb(0 0 0 / 0.45));
  }
</style>
