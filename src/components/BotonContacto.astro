---
// Botón de contacto: WhatsApp solo si el club cargó su número; si no, «Escríbenos» → Facebook.
// En la demo, el panel puede cargar el número y store.js repinta estos botones al instante.
import contenido from "../data/contenido.json";
import { enlaceContacto } from "../lib/contacto.js";

interface Props {
  mensaje?: string;
  cta?: boolean;
  accion?: string;
  variante?: "primario" | "secundario" | "claro" | "flotante";
  clase?: string;
  [atributo: `data-${string}`]: string | undefined;
}
const { cta = false, variante = "primario", clase = "", mensaje: _m, accion: _a, ...resto } = Astro.props;
// El botón principal dice «Clase de prueba» solo si el club confirmó que la ofrece.
const conClase = !!contenido.campos.clase_prueba?.valor;
const accion = cta ? (conClase ? "Clase de prueba" : "Pedir informes") : (Astro.props.accion ?? "");
const mensaje = cta
  ? conClase
    ? "Hola, quisiera agendar una clase de prueba de ajedrez."
    : "Hola, quisiera información sobre las clases de ajedrez."
  : (Astro.props.mensaje ?? "Hola, quisiera información sobre el Ajedrez Club Mokewa.");
const e = enlaceContacto(contenido.campos.whatsapp?.valor, mensaje, accion);
const flotante = variante === "flotante";
---

<a
  class={`${flotante ? "contacto-flotante no-imprimir" : `boton boton-${variante}`} boton-contacto ${clase}`}
  data-contacto
  data-cta={cta ? "" : undefined}
  data-mensaje={mensaje}
  data-accion={accion}
  data-tipo={e.tipo}
  href={e.href}
  rel="noopener"
  target="_blank"
  aria-label={e.aria}
  {...resto}
>
  <svg class="ico ico-wa" width={flotante ? 28 : 18} height={flotante ? 28 : 18} viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7c.1.2 1.9 2.9 4.6 4 1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.4-.3Z"></path></svg>
  <svg class="ico ico-fb" width={flotante ? 26 : 18} height={flotante ? 26 : 18} viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.5 1.6-1.5h1.7V4.4c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.3H7.5V14h2.7v8h3.3Z"></path></svg>
  {!flotante && <span class="contacto-texto">{e.texto}</span>}
</a>
