---
// Historia del club: trayectoria online (gráfico) e hitos verificados, cada uno con su fuente.
import GraficoAnual from "../GraficoAnual.astro";
import club from "../../data/club.json";
import { miles, fechaLarga, mesAnio } from "../../lib/formato.js";

const t = club.totales;
const corte = club.actualizado_en.slice(0, 10);
const anioActual = Number(corte.slice(0, 4));
const primero = [...club.torneos].sort((a, b) => a.dia.localeCompare(b.dia))[0];
const pico = [...club.temporadas].sort((a, b) => b.torneos - a.torneos)[0];
const ultimo = club.torneos.find((x) => x.id === club.ultimo);

const hitos = [
  { cuando: mesAnio(primero.dia), texto: `Primer torneo online del club en Lichess: «${primero.nombre}».`, fuente: primero.url, fuenteTexto: "Lichess" },
  { cuando: "agosto de 2021", texto: "Festival virtual multidisciplinario: ajedrez sub-09, sub-13 y libre, junto a recitación, cuento, deletreo y dibujo.", fuente: "https://www.radiosol.com.pe/promocionan-festival-ajedrez-club-moquegua.html", fuenteTexto: "Radio Sol 94.5" },
  { cuando: String(pico.anio), texto: `Año récord online: ${pico.torneos} torneos y ${miles(pico.jugadores)} jugadores distintos, con batallas interclubes como la «Integración Inca».`, fuente: club.equipo.url, fuenteTexto: "Lichess" },
  { cuando: "enero de 2024", texto: "II IRT Clásico Cerrado «Ajedrez Club Mokewa», torneo válido para rating FIDE.", fuente: "https://ratings.fide.com/report.phtml?event=350802", fuenteTexto: "FIDE" },
  ultimo && { cuando: mesAnio(ultimo.dia), texto: `Último torneo online: «${ultimo.nombre}», con ${ultimo.jugadores} jugadores.`, fuente: ultimo.url, fuenteTexto: "Lichess" },
].filter(Boolean);
---

<div class="historia">
  <div>
    <p class="antetitulo">Historia</p>
    <h2>{t.torneos} torneos y {miles(t.participaciones)} participaciones desde {t.desde}</h2>
    <ol class="hitos">
      {hitos.map((h) => (
        <li>
          <span class="hito-cuando">{h.cuando}</span>
          <span>{h.texto} <a class="fuente" href={h.fuente} rel="noopener" target="_blank">{h.fuenteTexto}</a></span>
        </li>
      ))}
    </ol>
  </div>
  <div class="tarjeta">
    <GraficoAnual temporadas={club.temporadas} anioParcial={anioActual} corte={fechaLarga(corte)} />
  </div>
</div>

<style>
  .historia {
    display: grid;
    gap: 28px;
  }
  @media (min-width: 960px) {
    .historia {
      grid-template-columns: 1fr 1.15fr;
      align-items: start;
    }
  }
  .hitos {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    border-left: 2px solid var(--linea);
  }
  .hitos li {
    position: relative;
    padding: 0 0 16px 20px;
    display: grid;
    gap: 2px;
    font-size: 0.97rem;
  }
  .hitos li::before {
    content: "";
    position: absolute;
    left: -7px;
    top: 5px;
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--oro);
  }
  .hito-cuando {
    font-weight: 650;
    color: var(--vino);
    font-size: 0.84rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .fuente {
    font-size: 0.8rem;
    color: var(--suave);
  }
</style>
