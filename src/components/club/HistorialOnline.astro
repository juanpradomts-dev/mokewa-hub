---
// Historial de los torneos online del club en Lichess (plegado para no alargar la página).
import club from "../../data/club.json";
import { fechaCorta, TIPO_TORNEO, miles } from "../../lib/formato.js";

const b = import.meta.env.BASE_URL.replace(/\/$/, "");
const t = club.totales;
const anios = [...new Set(club.torneos.map((x) => x.anio))].sort((a, c) => c - a);
const historial = club.torneos.filter((x) => x.terminado || new Date(x.fecha) < new Date(club.actualizado_en));
const formatos = club.formatos.filter((f) => f.nombre !== "Otros");
---

<details class="historial-online" id="historial">
  <summary>
    <span>
      <strong>Historial de los {t.torneos} torneos online</strong>
      <small>Desde {t.desde}, con su campeón y formato</small>
    </span>
  </summary>
  <ul class="formatos" aria-label="Formatos que el club repite">
    {formatos.map((f) => <li><span>{f.nombre}</span><b class="num">{f.n}</b></li>)}
  </ul>
  <div class="filtros" role="group" aria-label="Filtrar torneos">
    <div class="campo">
      <label for="f-anio">Año</label>
      <select id="f-anio">
        <option value="">Todos</option>
        {anios.map((a) => <option value={a}>{a}</option>)}
      </select>
    </div>
    <div class="campo">
      <label for="f-tipo">Sistema</label>
      <select id="f-tipo">
        <option value="">Todos</option>
        <option value="suizo">Suizo</option>
        <option value="arena">Arena</option>
        <option value="batalla">Batalla interclubes</option>
      </select>
    </div>
    <div class="campo">
      <label for="f-texto">Buscar torneo o campeón</label>
      <input id="f-texto" type="search" placeholder="Ej.: Jueves de Bala" autocomplete="off" />
    </div>
  </div>
  <p class="contador" id="f-contador" aria-live="polite"></p>
  <div class="tabla-envoltura">
    <table class="historial">
      <thead>
        <tr><th>Fecha</th><th>Torneo</th><th>Formato</th><th class="num">Jugadores</th><th>Campeón</th></tr>
      </thead>
      <tbody id="f-cuerpo">
        {historial.map((x) => (
          <tr data-anio={x.anio} data-tipo={x.tipo} data-texto={`${x.nombre} ${x.ganador ?? ""} ${x.formato}`.toLowerCase()}>
            <td class="fecha">{fechaCorta(x.dia)}</td>
            <td><a href={x.url} rel="noopener" target="_blank">{x.nombre}</a></td>
            <td>{TIPO_TORNEO[x.tipo]} · {x.ritmo.texto}</td>
            <td class="num">{miles(x.jugadores)}</td>
            <td>{x.ganador ? <a href={`${b}/jugador/?u=${encodeURIComponent(x.ganador)}`}>{x.ganador}</a> : "—"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p><button class="boton boton-secundario" id="f-mas" type="button">Mostrar más</button></p>
</details>

<script>
  const filas = [...document.querySelectorAll<HTMLTableRowElement>("#f-cuerpo tr")];
  const anio = document.getElementById("f-anio") as HTMLSelectElement;
  const tipo = document.getElementById("f-tipo") as HTMLSelectElement;
  const texto = document.getElementById("f-texto") as HTMLInputElement;
  const mas = document.getElementById("f-mas") as HTMLButtonElement;
  const contador = document.getElementById("f-contador")!;
  const PAGINA = 20;
  let visibles = PAGINA;

  function filtrar() {
    const q = texto.value.trim().toLowerCase();
    const hallados = filas.filter(
      (f) => (!anio.value || f.dataset.anio === anio.value) && (!tipo.value || f.dataset.tipo === tipo.value) && (!q || f.dataset.texto!.includes(q)),
    );
    for (const f of filas) f.hidden = true;
    hallados.slice(0, visibles).forEach((f) => (f.hidden = false));
    contador.textContent = `${hallados.length} ${hallados.length === 1 ? "torneo" : "torneos"}${hallados.length > visibles ? ` · mostrando ${visibles}` : ""}`;
    mas.hidden = hallados.length <= visibles;
  }
  for (const el of [anio, tipo, texto]) el.addEventListener("input", () => ((visibles = PAGINA), filtrar()));
  mas.addEventListener("click", () => ((visibles += 50), filtrar()));
  filtrar();
  if (location.hash === "#historial") (document.getElementById("historial") as HTMLDetailsElement).open = true;
</script>

<style>
  .historial-online {
    margin-top: 28px;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    background: var(--papel);
    padding: 0 20px;
  }
  .historial-online[open] {
    padding-bottom: 12px;
  }
  summary {
    cursor: pointer;
    min-height: 64px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
  }
  summary span {
    display: grid;
  }
  summary small {
    color: var(--suave);
  }
  .formatos {
    list-style: none;
    padding: 0;
    margin: 8px 0 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .formatos li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    background: var(--casilla);
    border-radius: 999px;
    padding: 4px 8px 4px 14px;
    font-weight: 550;
    font-size: 0.92rem;
  }
  .formatos b {
    background: var(--papel);
    border-radius: 999px;
    padding: 1px 9px;
    font-size: 0.85rem;
  }
  .filtros {
    display: grid;
    gap: 0 12px;
  }
  @media (min-width: 720px) {
    .filtros {
      grid-template-columns: 140px 220px 1fr;
    }
  }
  .contador {
    font-size: 0.9rem;
    color: var(--suave);
  }
  .historial td.fecha {
    white-space: nowrap;
    color: var(--suave);
  }
  .historial td a {
    display: inline-block;
    padding: 10px 0;
    min-height: 44px;
    overflow-wrap: anywhere;
  }
</style>
