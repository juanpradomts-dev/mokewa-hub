---
// Comunidad: práctica entre clases en el equipo del club en Lichess y noticias del club.
// Las noticias las publica el club desde el panel; si no hay, la sección no se muestra.
import club from "../../data/club.json";
import { fechaLarga } from "../../lib/formato.js";

const proximos = club.proximos.map((id) => club.torneos.find((x) => x.id === id)).filter(Boolean);
---

<div class="comunidad">
  <div class="comunidad-grid">
    <div>
      <p class="antetitulo">Comunidad</p>
      <h2>Entre clase y clase, se sigue jugando</h2>
      <p class="bajada">El club tiene un equipo gratuito en Lichess con {club.equipo.miembros} miembros: ahí se juegan los torneos en línea y se practica desde el celular.</p>
    </div>
    <div class="tarjeta pasos-tarjeta">
      {proximos.length > 0 && (
        <ul class="proximos">
          {proximos.map((p) => (
            <li><a href={p.url} rel="noopener" target="_blank"><strong>{p.nombre}</strong><span>{fechaLarga(p.dia)} · {p.ritmo.texto}</span></a></li>
          ))}
        </ul>
      )}
      <ol class="pasos">
        <li>Crea tu cuenta gratis en <a href="https://lichess.org/signup" rel="noopener" target="_blank">Lichess</a>.</li>
        <li>Pide tu ingreso al <a href={club.equipo.url} rel="noopener" target="_blank">equipo del club</a>.</li>
        <li>Juega los torneos del club desde el celular.</li>
      </ol>
      <a class="boton boton-secundario" href={club.equipo.url} rel="noopener" target="_blank">Unirme al equipo</a>
    </div>
  </div>

  <div class="noticias-bloque" id="noticias-bloque" hidden>
    <h3 class="h-sub">Noticias del club</h3>
    <div class="noticias" id="noticias"></div>
  </div>
</div>

<script>
  import { noticias, alCambiar } from "../../lib/store.js";
  import { esc } from "../../lib/html.js";
  import { fechaLarga } from "../../lib/formato.js";

  const bloque = document.getElementById("noticias-bloque")!;
  const caja = document.getElementById("noticias")!;
  function pintar() {
    const lista = noticias();
    bloque.hidden = !lista.length;
    caja.innerHTML = lista
      .map((n) => `<article class="tarjeta noticia"><p class="meta">${fechaLarga(n.fecha)}</p><h4>${esc(n.titulo)}</h4><p>${esc(n.cuerpo).replace(/\n/g, "<br>")}</p></article>`)
      .join("");
  }
  pintar();
  alCambiar(pintar);
</script>

<style>
  .comunidad-grid {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 900px) {
    .comunidad-grid {
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
      gap: 48px;
    }
  }
  .proximos {
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
    display: grid;
    gap: 8px;
  }
  .proximos a {
    display: grid;
    min-height: 44px;
    padding: 10px 12px;
    border-radius: 10px;
    background: var(--casilla);
    text-decoration: none;
    color: var(--tinta);
  }
  .pasos {
    padding-left: 1.3em;
    margin: 0 0 18px;
  }
  .pasos li {
    margin-bottom: 6px;
  }
  .h-sub {
    font-size: clamp(1.3rem, 3.5vw, 1.7rem);
    margin: 40px 0 14px;
  }
  .noticias {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 900px) {
    .noticias {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  :global(.noticia h4) {
    font-family: var(--serif);
    font-size: 1.15rem;
    margin: 0 0 8px;
  }
  :global(.noticia .meta) {
    font-size: 0.85rem;
    color: var(--suave);
    margin: 0 0 6px;
  }
</style>
