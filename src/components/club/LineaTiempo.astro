---
// «Nuestra historia»: LÍNEA DE TIEMPO horizontal (2022 → hoy) de los torneos PRESENCIALES del club.
// Un eje de casillas de tablero; cada torneo es un punto del que sale una rama curva hacia su
// tarjeta con los campeones. Se desliza en horizontal (dedo, arrastre con inercia o flechas) y se
// acomoda sola en el torneo más cercano. Un caballo salta de torneo en torneo, el eje se enciende por
// donde pasó y, al verse por primera vez, el caballo viaja de 2022 a hoy. «Recorrer la historia»
// repite el viaje paso a paso.
// Datos: src/data/historia.json (clasificaciones públicas de Chess-Results, con su enlace).
// De cada campeón solo el nombre y la inicial del apellido; si una familia lo pide, va a «ocultar».
// Sin JavaScript se ve la lista simple de abajo.
import historia from "../../data/historia.json";
import Caballo from "../Caballo.astro";
import { esProduccion } from "../../lib/contenido.js";
import { LEMA } from "../../lib/club.js";

type Campeon = { categoria: string | null; nombre: string };
type Evento = { fecha: string; fecha_texto: string; torneo: string; campeones: Campeon[]; fuentes: string[] };

const ocultos = new Set<string>(historia.ocultar ?? []);
// Orden cronológico: de lo más antiguo (izquierda) a lo más reciente (derecha).
const eventos: Evento[] = [...historia.torneos, ...historia.hitos].sort((a, b) => a.fecha.localeCompare(b.fecha) || a.torneo.localeCompare(b.torneo));
const anios = [...new Set(eventos.map((e) => e.fecha.slice(0, 4)))].sort();
const conRating = (e: Evento) => /\bIRT\b|FIDE/.test(e.torneo); // IRT = válido para el rating FIDE
const datos = eventos.map((e) => ({
  anio: e.fecha.slice(0, 4),
  mes: e.fecha_texto.replace(/ de \d{4}$/, ""),
  torneo: e.torneo,
  rating: conRating(e),
  fuente: e.fuentes[0] ?? null,
  fide: (e.fuentes[0] ?? "").includes("fide.com"),
  campeones: e.campeones.map((c) => ({ nombre: ocultos.has(c.nombre) ? null : c.nombre, categoria: c.categoria })),
}));
const json = JSON.stringify(datos).replace(/</g, "\\u003c");
---

<div class="historia" data-historia>
  <div class="historia-cabeza">
    <p class="antetitulo">Nuestra historia</p>
    <h2>{LEMA}</h2>
    <p class="bajada">Desde {anios[0]}, los campeones de los torneos presenciales del club.</p>
  </div>

  <!-- Controles de la línea de tiempo (solo con JavaScript) -->
  <div class="tl-controles" data-controles hidden>
    <div class="tl-anios" role="group" aria-label="Ir a un año">
      <span class="tl-pildora" aria-hidden="true"></span>
      {anios.map((a) => <button type="button" data-ir={a} aria-pressed="false">{a}</button>)}
    </div>
    <div class="tl-navegar">
      <button type="button" class="tl-flecha" data-paso="-1" aria-label="Torneo anterior">←</button>
      <button type="button" class="tl-flecha" data-paso="1" aria-label="Torneo siguiente">→</button>
      <button type="button" class="tl-play" data-play aria-pressed="false"><span aria-hidden="true">▶</span> Recorrer la historia</button>
    </div>
  </div>
  <p class="estado" data-estado aria-live="polite"></p>

  <div class="tl-marco" data-marco hidden>
    <div class="tl-pista" data-pista tabindex="0" role="region" aria-label="Línea de tiempo de los campeones, de 2022 a hoy. Se desliza en horizontal; las flechas del teclado pasan de torneo en torneo.">
      <div class="tl-lienzo" data-lienzo>
        <svg class="tl-ramas" aria-hidden="true"></svg>
        <div class="tl-eje" aria-hidden="true"></div>
        <div class="tl-eje-luz" aria-hidden="true"></div>
        <div class="tl-caballo" data-caballo aria-hidden="true"><Caballo tam="100%" /></div>
      </div>
    </div>
  </div>
  <p class="tl-pista-ayuda" data-solo-js hidden>Desliza a los lados para viajar en el tiempo. Toca un campeón para seguir todos sus títulos.</p>
  <script type="application/json" data-datos-historia set:html={json} />

  <!-- Sin JavaScript: la misma historia en lista -->
  <ol class="lista-historia" data-lista>
    {datos.map((e) => (
      <li>
        <strong>{e.mes} de {e.anio} · {e.torneo}</strong>
        {e.campeones.length > 0 && <>: {e.campeones.map((c) => `${c.categoria ? c.categoria + " " : ""}${c.nombre ?? "Campeón"}`).join(" · ")}</>}
        {e.fuente && <> · <a href={e.fuente} rel="noopener" target="_blank">{e.fide ? "Informe FIDE" : "Resultados"}</a></>}
      </li>
    ))}
  </ol>

  {!esProduccion && (
    <p class="pendiente">
      <strong>Por confirmar con el club:</strong> las victorias de sus jugadores en torneos de otros organizadores (regionales, nacionales y escolares).
    </p>
  )}
  <p class="nota-fuente">
    Fuente: clasificaciones públicas de cada torneo en <a href={historia.fuente.url} rel="noopener" target="_blank">{historia.fuente.texto}</a>. De cada campeón se muestra el nombre y la inicial del apellido.
  </p>
</div>

<script>
  type Campeon = { nombre: string | null; categoria: string | null };
  type Ev = { anio: string; mes: string; torneo: string; rating: boolean; fuente: string | null; fide: boolean; campeones: Campeon[] };

  const raiz = document.querySelector<HTMLElement>("[data-historia]");
  if (raiz) iniciar(raiz);

  function iniciar(raiz: HTMLElement) {
    const datos: Ev[] = JSON.parse(raiz.querySelector("[data-datos-historia]")!.textContent || "[]");
    const n = datos.length;
    const marco = raiz.querySelector<HTMLElement>("[data-marco]")!;
    const pista = raiz.querySelector<HTMLElement>("[data-pista]")!;
    const lienzo = raiz.querySelector<HTMLElement>("[data-lienzo]")!;
    const svg = lienzo.querySelector<SVGSVGElement>(".tl-ramas")!;
    const eje = lienzo.querySelector<HTMLElement>(".tl-eje")!;
    const luz = lienzo.querySelector<HTMLElement>(".tl-eje-luz")!;
    const caballo = lienzo.querySelector<HTMLElement>("[data-caballo]")!;
    const estado = raiz.querySelector<HTMLElement>("[data-estado]")!;
    const pildora = raiz.querySelector<HTMLElement>(".tl-pildora")!;
    const botonesAnio = [...raiz.querySelectorAll<HTMLButtonElement>("[data-ir]")];
    const play = raiz.querySelector<HTMLButtonElement>("[data-play]")!;
    raiz.querySelector<HTMLElement>("[data-controles]")!.hidden = false;
    raiz.querySelector<HTMLElement>("[data-solo-js]")!.hidden = false;
    marco.hidden = false;
    raiz.classList.add("con-linea");

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, clase = "", texto = "") => {
      const e = document.createElement(tag);
      if (clase) e.className = clase;
      if (texto) e.textContent = texto;
      return e;
    };
    const plural = (k: number, uno: string, varios: string) => `${k} ${k === 1 ? uno : varios}`;
    const limitar = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
    const suave = (p: number) => (p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2);

    // ---- Tarjetas, puntos del eje, marcas de año y años de fondo
    const lista = el("ol", "tl-lista");
    lienzo.append(lista);
    const puntos: HTMLElement[] = [];
    const tarjetas = datos.map((e, k) => {
      const li = el("li", `tl-tarjeta ${k % 2 ? "abajo" : "arriba"}${e.campeones.length ? "" : " hito"}`);
      const cabeza = el("div", "tl-cabeza");
      cabeza.append(el("span", "tl-cuando", `${e.mes} ${e.anio}`));
      if (e.rating) cabeza.append(el("span", "tl-sello", "Rating FIDE"));
      li.append(cabeza, el("h4", "", e.torneo));
      if (e.campeones.length) {
        const ul = el("ul", "tl-medallas");
        for (const c of e.campeones) {
          const item = el("li");
          const b = el("button", "tl-medalla");
          b.type = "button";
          b.disabled = !c.nombre;
          b.dataset.nombre = c.nombre ?? "";
          b.setAttribute("aria-pressed", "false");
          const txt = el("span", "tl-medalla-texto");
          txt.append(el("span", "tl-nombre", c.nombre ?? "Campeón"));
          if (c.categoria) txt.append(el("span", "tl-cat", c.categoria));
          b.append(el("span", "tl-corona", "♛︎"), txt);
          b.addEventListener("click", () => seguir(c.nombre!));
          item.append(b);
          ul.append(item);
        }
        li.append(ul);
      }
      if (e.fuente) {
        const a = el("a", "tl-fuente", e.fide ? "Informe FIDE →" : "Ver resultados →");
        a.href = e.fuente;
        a.target = "_blank";
        a.rel = "noopener";
        a.setAttribute("aria-label", `${e.fide ? "Informe FIDE" : "Resultados"} de ${e.torneo}`);
        li.append(a);
      }
      lista.append(li);
      const p = el("span", "tl-punto");
      p.setAttribute("aria-hidden", "true");
      lienzo.append(p);
      puntos.push(p);
      return li;
    });
    const anios = [...new Set(datos.map((e) => e.anio))].map((a) => {
      const m = el("span", "tl-marca-anio", a);
      const f = el("span", "tl-fondo-anio");
      m.setAttribute("aria-hidden", "true");
      f.setAttribute("aria-hidden", "true");
      f.dataset.anio = a; // el número se dibuja con CSS (decorativo)
      lienzo.append(m);
      lienzo.prepend(f);
      return { anio: a, m, f, medio: 0 };
    });

    // ---- Geometría: cada torneo ocupa un «paso» del eje; las tarjetas alternan arriba y abajo
    let xs: number[] = [];
    let yEje = 0;
    let salto = 30;
    function disponer() {
      const angosto = pista.clientWidth < 700;
      const paso = angosto ? 150 : 190;
      const ancho = angosto ? 250 : 290;
      salto = angosto ? 22 : 30;
      // Medio ancho de pantalla en cada extremo: el primer y el último torneo pueden quedar al centro.
      const margen = Math.max(angosto ? 40 : 90, pista.clientWidth / 2);
      const rama = angosto ? 46 : 58;
      tarjetas.forEach((t) => (t.style.width = `${ancho}px`));
      const altoArriba = Math.max(...tarjetas.filter((_, k) => k % 2 === 0).map((t) => t.offsetHeight));
      const altoAbajo = Math.max(...tarjetas.filter((_, k) => k % 2 === 1).map((t) => t.offsetHeight));
      yEje = 24 + altoArriba + rama;
      const H = yEje + rama + altoAbajo + 34;
      // Un respiro entre años: el cambio de año se nota en el eje
      let x = margen;
      xs = datos.map((e, k) => {
        if (k > 0 && e.anio !== datos[k - 1].anio) x += paso * 0.55;
        const pos = x;
        x += paso;
        return pos;
      });
      const W = x - paso + Math.max(ancho * 0.72 + 30, margen);
      lienzo.style.width = `${W}px`;
      lienzo.style.height = `${H}px`;
      eje.style.top = luz.style.top = `${yEje - 7}px`;
      tarjetas.forEach((t, k) => {
        t.style.left = `${Math.round(xs[k] - ancho * 0.28)}px`;
        t.style.top = `${Math.round(k % 2 === 0 ? yEje - rama - t.offsetHeight : yEje + rama)}px`;
        puntos[k].style.left = `${xs[k]}px`;
        puntos[k].style.top = `${yEje}px`;
      });
      for (const a of anios) {
        const ks = datos.flatMap((e, k) => (e.anio === a.anio ? [k] : []));
        // Lejos del punto: el caballo (58 px) no debe tapar el año
        a.m.style.left = `${xs[ks[0]] - Math.max(82, paso * 0.5)}px`;
        a.m.style.top = `${yEje}px`;
        a.medio = (xs[ks[0]] + xs[ks[ks.length - 1]]) / 2;
        a.f.style.left = `${a.medio}px`;
        a.f.style.top = `${yEje}px`;
      }
      ramas(ancho);
    }

    function ramas(ancho: number) {
      const W = lienzo.offsetWidth;
      const H = lienzo.offsetHeight;
      svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
      svg.setAttribute("width", String(W));
      svg.setAttribute("height", String(H));
      svg.replaceChildren();
      tarjetas.forEach((t, k) => {
        const x0 = xs[k];
        const x1 = t.offsetLeft + ancho * 0.28 + 30;
        const y1 = k % 2 === 0 ? t.offsetTop + t.offsetHeight : t.offsetTop;
        const yMedio = (yEje + y1) / 2;
        const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
        path.setAttribute("d", `M${x0},${yEje} C${x0},${yMedio} ${x1},${yMedio} ${x1},${y1}`);
        path.dataset.k = String(k);
        if (t.classList.contains("vista")) path.classList.add("vista");
        svg.append(path);
      });
    }

    // ---- Movimiento: un solo bucle (requestAnimationFrame) mueve la pista y el caballo.
    // El caballo sigue el centro de la pista con suavidad y, entre torneo y torneo, salta en arco
    // como un caballo de ajedrez. El eje se enciende por donde ya pasó.
    let kx = 0;
    let actual = -1;
    let animacion: { desde: number; hasta: number; t0: number; dur: number; fin?: () => void } | null = null;
    let inercia = 0;
    let corriendo = false;
    const centro = () => pista.scrollLeft + pista.clientWidth / 2;
    const maxScroll = () => pista.scrollWidth - pista.clientWidth;
    const masCercano = (x: number) => xs.reduce((m, v, k) => (Math.abs(v - x) < Math.abs(xs[m] - x) ? k : m), 0);

    function despertar() {
      if (corriendo) return;
      corriendo = true;
      requestAnimationFrame(cuadro);
    }
    function cuadro(t: number) {
      if (animacion) {
        const a = animacion;
        if (!a.t0) a.t0 = t;
        const p = a.dur ? Math.min(1, (t - a.t0) / a.dur) : 1;
        pista.scrollLeft = a.desde + (a.hasta - a.desde) * suave(p);
        if (p >= 1) {
          animacion = null;
          a.fin?.();
        }
      } else if (inercia) {
        const antes = pista.scrollLeft;
        pista.scrollLeft += inercia;
        inercia *= 0.93;
        if (Math.abs(inercia) < 0.5 || pista.scrollLeft === antes) {
          inercia = 0;
          programarIman();
        }
      }
      const destino = limitar(centro(), xs[0], xs[n - 1]);
      const previo = kx;
      kx += (destino - kx) * 0.2;
      if (Math.abs(destino - kx) < 0.3) kx = destino;
      pintar(kx - previo);
      if (animacion || inercia || kx !== destino) requestAnimationFrame(cuadro);
      else {
        corriendo = false;
        pintar(0);
      }
    }
    function pintar(velocidad: number) {
      let i = 0;
      while (i < n - 2 && kx > xs[i + 1]) i++;
      const tramo = n > 1 ? limitar((kx - xs[i]) / (xs[i + 1] - xs[i]), 0, 1) : 0;
      const alto = Math.sin(Math.PI * tramo) * salto;
      const giro = limitar(velocidad * 1.1, -16, 16);
      caballo.style.transform = `translate3d(${kx.toFixed(1)}px, ${(yEje - alto).toFixed(1)}px, 0) rotate(${giro.toFixed(1)}deg)`;
      luz.style.width = `${kx.toFixed(1)}px`;
      const c = centro();
      for (const a of anios) a.f.style.transform = `translate(-50%, -50%) translateX(${((c - a.medio) * 0.3).toFixed(1)}px)`;
      marco.classList.toggle("al-inicio", pista.scrollLeft < 4);
      marco.classList.toggle("al-final", pista.scrollLeft > maxScroll() - 4);
      const k = masCercano(kx);
      if (k !== actual) activar(k);
    }
    function activar(k: number) {
      actual = k;
      tarjetas.forEach((t, i) => t.classList.toggle("activa", i === k));
      puntos.forEach((p, i) => {
        p.classList.toggle("activo", i === k);
        p.classList.toggle("pasado", i < k);
      });
      svg.querySelectorAll("path").forEach((p) => p.classList.toggle("activa", p.dataset.k === String(k)));
      const anio = datos[k].anio;
      botonesAnio.forEach((b) => {
        const si = b.dataset.ir === anio;
        b.setAttribute("aria-pressed", String(si));
        if (si) {
          pildora.style.width = `${b.offsetWidth}px`;
          pildora.style.height = `${b.offsetHeight}px`;
          pildora.style.transform = `translate(${b.offsetLeft}px, ${b.offsetTop}px)`;
        }
      });
      play.style.setProperty("--avance", String(n > 1 ? k / (n - 1) : 1));
    }

    // Desplazamiento animado propio: también es fluido en equipos con «reducir animaciones»
    function irA(k: number, dur?: number, fin?: () => void) {
      k = limitar(k, 0, n - 1);
      inercia = 0;
      const desde = pista.scrollLeft;
      const hasta = limitar(xs[k] - pista.clientWidth / 2, 0, maxScroll());
      const d = Math.abs(hasta - desde);
      if (d < 2) {
        animacion = null;
        fin?.();
        return;
      }
      animacion = { desde, hasta, t0: 0, dur: dur ?? limitar(320 + d * 0.4, 420, 1500), fin };
      despertar();
    }
    const fijar = (k: number) => {
      animacion = null;
      pista.scrollLeft = limitar(xs[k] - pista.clientWidth / 2, 0, maxScroll());
      kx = limitar(centro(), xs[0], xs[n - 1]);
      pintar(0);
    };

    // Imán: al soltar, la línea se acomoda en el torneo más cercano
    let espera = 0;
    let dedo = false;
    let jugando = false;
    let arrastre: { x: number; s: number; ux: number; t: number; v: number } | null = null;
    function programarIman() {
      clearTimeout(espera);
      if (animacion || inercia || arrastre || dedo || jugando) return;
      espera = window.setTimeout(() => {
        if (!animacion && !inercia && !arrastre && !dedo && !jugando) irA(masCercano(centro()), 380);
      }, 170);
    }
    pista.addEventListener(
      "scroll",
      () => {
        despertar();
        programarIman();
      },
      { passive: true },
    );

    // ---- Navegación
    botonesAnio.forEach((b) =>
      b.addEventListener("click", () => {
        detener();
        irA(datos.findIndex((e) => e.anio === b.dataset.ir));
      }),
    );
    raiz.querySelectorAll<HTMLElement>("[data-paso]").forEach((b) =>
      b.addEventListener("click", () => {
        detener();
        irA(actual + Number(b.dataset.paso));
      }),
    );
    pista.addEventListener("keydown", (ev) => {
      const paso = ({ ArrowRight: 1, ArrowLeft: -1 } as Record<string, number>)[ev.key];
      if (paso || ev.key === "Home" || ev.key === "End") {
        ev.preventDefault();
        detener();
        irA(paso ? actual + paso : ev.key === "Home" ? 0 : n - 1);
      }
    });

    // Recorrer la historia: de 2022 a hoy, torneo por torneo (la barra del botón muestra el avance)
    let reloj = 0;
    let introduccion = true;
    function detener() {
      introduccion = false;
      if (!jugando) return;
      jugando = false;
      clearTimeout(reloj);
      play.setAttribute("aria-pressed", "false");
      play.innerHTML = '<span aria-hidden="true">▶</span> Recorrer la historia';
    }
    function siguiente(k: number) {
      if (!jugando) return;
      irA(k, 900, () => {
        if (!jugando) return;
        if (k >= n - 1) return detener();
        reloj = window.setTimeout(() => siguiente(k + 1), 750);
      });
    }
    play.addEventListener("click", () => {
      if (jugando) return detener();
      detener();
      jugando = true;
      play.setAttribute("aria-pressed", "true");
      play.innerHTML = '<span aria-hidden="true">❚❚</span> Pausar';
      if (actual >= n - 1) irA(0, 1300, () => (reloj = window.setTimeout(() => siguiente(1), 600)));
      else siguiente(actual + 1);
    });

    // Arrastrar con el mouse, con inercia al soltar (en celular el dedo ya la tiene)
    pista.addEventListener("pointerdown", (ev) => {
      detener();
      animacion = null;
      inercia = 0;
      if (ev.pointerType !== "mouse") {
        dedo = true;
        return;
      }
      if ((ev.target as HTMLElement).closest("button, a")) return;
      arrastre = { x: ev.clientX, s: pista.scrollLeft, ux: ev.clientX, t: ev.timeStamp, v: 0 };
      pista.classList.add("arrastrando");
    });
    window.addEventListener("pointermove", (ev) => {
      if (!arrastre) return;
      pista.scrollLeft = arrastre.s - (ev.clientX - arrastre.x);
      const dt = ev.timeStamp - arrastre.t;
      if (dt > 0) arrastre.v = 0.75 * ((arrastre.ux - ev.clientX) / dt) + 0.25 * arrastre.v;
      arrastre.ux = ev.clientX;
      arrastre.t = ev.timeStamp;
    });
    const soltar = (ev: PointerEvent) => {
      if (ev.pointerType !== "mouse") {
        if (!dedo) return;
        dedo = false;
        programarIman();
        return;
      }
      if (!arrastre) return;
      const v = ev.timeStamp - arrastre.t > 80 ? 0 : arrastre.v; // se detuvo antes de soltar: sin inercia
      arrastre = null;
      pista.classList.remove("arrastrando");
      if (Math.abs(v) > 0.12) {
        inercia = limitar(v * 16, -60, 60);
        despertar();
      } else programarIman();
    };
    window.addEventListener("pointerup", soltar);
    window.addEventListener("pointercancel", soltar);
    pista.addEventListener("wheel", () => detener(), { passive: true });

    // ---- Seguir a un campeón por toda la historia
    let nombre = "";
    function seguir(nuevo: string) {
      nombre = nombre === nuevo ? "" : nuevo;
      let total = 0;
      const suyos = new Set<string>();
      tarjetas.forEach((t, k) => {
        const s = datos[k].campeones.filter((c) => c.nombre === nombre).length;
        total += s;
        if (s) suyos.add(datos[k].anio);
        t.classList.toggle("atenuada", !!nombre && !s);
        puntos[k].classList.toggle("con-titulo", !!nombre && s > 0);
      });
      raiz.querySelectorAll<HTMLElement>(".tl-medalla").forEach((m) => m.setAttribute("aria-pressed", String(!!nombre && m.dataset.nombre === nombre)));
      estado.replaceChildren();
      if (nombre) {
        const quitar = el("button", "quitar", "Dejar de seguir");
        quitar.type = "button";
        quitar.addEventListener("click", () => seguir(nombre));
        estado.append(`${nombre}: ${plural(total, "título", "títulos")} (${[...suyos].join(", ")}). Sus torneos brillan en el eje. `, quitar);
      }
    }

    // ---- Las tarjetas aparecen al entrar en la pista y su rama se dibuja
    const aparecer = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          const t = e.target as HTMLLIElement;
          t.classList.add("vista");
          svg.querySelector(`path[data-k="${tarjetas.indexOf(t)}"]`)?.classList.add("vista");
          aparecer.unobserve(t);
        }
      },
      { root: pista, rootMargin: "0px -4% 0px -4%", threshold: 0.12 },
    );

    // ---- Arranque: la línea espera en 2022 y, al verse por primera vez, el caballo viaja hasta hoy.
    // Cualquier toque, rueda o tecla corta el viaje.
    disponer();
    fijar(0);
    tarjetas.forEach((t) => aparecer.observe(t));
    const entrar = new IntersectionObserver(
      (en) => {
        if (!en.some((x) => x.isIntersecting)) return;
        entrar.disconnect();
        window.setTimeout(() => {
          if (introduccion) irA(n - 1, limitar(n * 170, 1800, 3400), () => (introduccion = false));
        }, 350);
      },
      { threshold: 0.35 },
    );
    entrar.observe(pista);
    let anchoPrevio = pista.clientWidth;
    new ResizeObserver(() => {
      if (pista.clientWidth === anchoPrevio) return;
      anchoPrevio = pista.clientWidth;
      const k = Math.max(0, actual);
      disponer();
      fijar(k);
      activar(actual);
    }).observe(pista);
  }
</script>

