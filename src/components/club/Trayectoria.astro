---
// Trayectoria en línea del club (Lichess): gráfico por año con el récord y el formato actual.
import GraficoAnual from "../GraficoAnual.astro";
import club from "../../data/club.json";
import { miles, fechaLarga } from "../../lib/formato.js";

const t = club.totales;
const corte = club.actualizado_en.slice(0, 10);
const anioActual = Number(corte.slice(0, 4));
const pico = [...club.temporadas].sort((a, b) => b.torneos - a.torneos)[0];

// Formato actual, calculado: torneos desde el año siguiente al récord, sus meses y cuántos son por nivel.
const MESES = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];
const recientes = club.torneos.filter((x) => x.anio > pico.anio);
const meses = [...new Set(recientes.map((x) => Number(x.dia.slice(5, 7))))].sort((a, b) => a - b);
const porNivel = recientes.filter((x) => /h[ií]brido|b[aá]sico|intermedio|avan|avz/i.test(x.nombre)).length;
const soloVerano = meses.length > 0 && meses.every((m) => m <= 2);
const formatoActual = recientes.length
  ? soloVerano
    ? `Desde ${pico.anio + 1}, el club juega en línea en la temporada de verano (${meses.map((m) => MESES[m - 1]).join(" y ")}), con torneos por nivel: básico, intermedio y avanzado (${porNivel} de ${recientes.length}).`
    : `Desde ${pico.anio + 1}, el club organizó ${recientes.length} torneos en línea, ${porNivel} de ellos por nivel.`
  : "";

---

<div class="trayectoria">
  <div>
    <p class="antetitulo">En línea</p>
    <h2>Trayectoria en Lichess</h2>
    <p class="bajada">
      {t.torneos} torneos y {miles(t.participaciones)} participaciones desde {t.desde}. El récord llegó en {pico.anio}: {pico.torneos} torneos y {miles(pico.jugadores)} jugadores en un solo año.{" "}
      {formatoActual}
    </p>
  </div>
  <div class="tarjeta">
    <GraficoAnual
      temporadas={club.temporadas}
      anioParcial={anioActual}
      corte={fechaLarga(corte)}
      destacar={pico.anio}
      etiquetaDestacado="Año récord"
      tramo={recientes.length && soloVerano ? { desde: pico.anio + 1, hasta: anioActual, texto: "Temporada de verano por niveles" } : undefined}
    />
  </div>
</div>

<style>
  .trayectoria {
    display: grid;
    gap: 28px;
  }
  @media (min-width: 960px) {
    .trayectoria {
      grid-template-columns: 1fr 1.15fr;
      align-items: start;
    }
  }
</style>
