---
// Insignia redonda como la del club: caballo sobre círculo blanco.
import Caballo from "./Caballo.astro";
interface Props {
  tam?: number;
}
const { tam = 40 } = Astro.props;
---

<span class="insignia" style={`--tam:${tam}px`} aria-hidden="true"><Caballo tam={Math.round(tam * 0.78)} /></span>

<style>
  .insignia {
    width: var(--tam);
    height: var(--tam);
    border-radius: 50%;
    background: #fff;
    border: 1.5px solid #e2d8cb;
    display: inline-grid;
    place-items: center;
    flex: none;
  }
</style>
