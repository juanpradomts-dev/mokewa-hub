---
// Trayectoria online del club: barras por año (una sola serie, sin leyenda).
// Se destaca el año récord y se marca el tramo del formato actual. No se oculta ningún año:
// solo cambia el encuadre. El año en curso va con textura porque está incompleto.
import { miles } from "../lib/formato.js";

interface Props {
  temporadas: { anio: number; torneos: number; jugadores: number; participaciones: number }[];
  anioParcial?: number;
  corte?: string;
  destacar?: number;
  etiquetaDestacado?: string;
  tramo?: { desde: number; hasta: number; texto: string };
}
const { temporadas, anioParcial, corte = "", destacar, etiquetaDestacado = "", tramo } = Astro.props;
const W = 640, H = 280, M = { t: 44, r: 8, b: 34, l: 8 };
const max = Math.max(...temporadas.map((t) => t.torneos));
const paso = (W - M.l - M.r) / temporadas.length;
const ancho = Math.min(56, paso - 14);
const y = (v: number) => M.t + (H - M.t - M.b) * (1 - v / max);
const base = H - M.b;
// barra con extremo superior redondeado (4 px) anclada a la línea base
const barra = (x: number, v: number) => {
  const top = y(v), r = Math.min(4, (base - top) / 2);
  return `M${x},${base}V${top + r}Q${x},${top} ${x + r},${top}H${x + ancho - r}Q${x + ancho},${top} ${x + ancho},${top + r}V${base}Z`;
};
---

<figure class="grafico">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="g-titulo g-desc">
    <title id="g-titulo">Torneos online organizados por el club en Lichess, por año</title>
    <desc id="g-desc">{temporadas.map((t) => `${t.anio}: ${t.torneos} torneos`).join("; ")}</desc>
    <defs>
      <pattern id="rayado" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="7" height="7" fill="var(--g-barra)" opacity="0.35"></rect>
        <line x1="0" y1="0" x2="0" y2="7" stroke="var(--g-barra)" stroke-width="3"></line>
      </pattern>
    </defs>
    <line x1={M.l} x2={W - M.r} y1={base} y2={base} class="g-base"></line>
    {tramo && (() => {
      const i0 = temporadas.findIndex((t) => t.anio === tramo.desde);
      const i1 = temporadas.findIndex((t) => t.anio === tramo.hasta);
      if (i0 < 0 || i1 < 0) return null;
      const x0 = M.l + i0 * paso + 6, x1 = M.l + (i1 + 1) * paso - 6;
      const alto = Math.max(...temporadas.slice(i0, i1 + 1).map((t) => t.torneos));
      const yT = y(alto) - 30;
      return (
        <g class="g-tramo">
          <path d={`M${x0},${yT + 8}V${yT}H${x1}V${yT + 8}`} />
          <text x={(x0 + x1) / 2} y={yT - 7} text-anchor="middle">{tramo.texto}</text>
        </g>
      );
    })()}
    {
      temporadas.map((t, i) => {
        const x = M.l + i * paso + (paso - ancho) / 2;
        const parcial = t.anio === anioParcial;
        const destacado = t.anio === destacar;
        return (
          <g class:list={["g-barra", { destacado }]} tabindex="0" aria-label={`${t.anio}: ${t.torneos} torneos, ${t.jugadores} jugadores${destacado ? `, ${etiquetaDestacado}` : ""}`}>
            <rect x={M.l + i * paso} y={M.t - 20} width={paso} height={H - M.t + 20} fill="transparent" />
            <path d={barra(x, t.torneos)} fill={parcial ? "url(#rayado)" : destacado ? "var(--g-destacado)" : "var(--g-barra)"} />
            <text x={x + ancho / 2} y={y(t.torneos) - 8} class="g-valor" text-anchor="middle">{t.torneos}</text>
            {destacado && etiquetaDestacado && (
              <text x={x + ancho / 2} y={y(t.torneos) - 26} class="g-etiqueta" text-anchor="middle">{etiquetaDestacado}</text>
            )}
            <text x={x + ancho / 2} y={H - 12} class="g-anio" text-anchor="middle">{t.anio}{parcial ? "*" : ""}</text>
            <foreignObject x={Math.min(Math.max(x + ancho / 2 - 80, 0), W - 160)} y={Math.max(y(t.torneos) - 74, 0)} width="160" height="62" class="g-tip">
              <div>
                <strong>{t.anio}{parcial ? " (parcial)" : ""}</strong>
                <span>{t.torneos} torneos · {miles(t.jugadores)} jugadores</span>
              </div>
            </foreignObject>
          </g>
        );
      })
    }
  </svg>
  <figcaption>
    {`Torneos online del club en Lichess por año (arena + suizo). ${anioParcial ? `*${anioParcial}: datos hasta el ${corte}. ` : ""}Fuente: API pública de Lichess, cálculo automático.`}
  </figcaption>
  <details class="g-tabla">
    <summary>Ver como tabla</summary>
    <div class="tabla-envoltura">
      <table>
        <thead><tr><th>Año</th><th class="num">Torneos</th><th class="num">Jugadores distintos</th><th class="num">Participaciones</th></tr></thead>
        <tbody>
          {temporadas.map((t) => (
            <tr><td>{t.anio}{t.anio === anioParcial ? "*" : ""}</td><td class="num">{t.torneos}</td><td class="num">{miles(t.jugadores)}</td><td class="num">{miles(t.participaciones)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .grafico {
    margin: 0;
    --g-barra: color-mix(in srgb, var(--suave) 85%, var(--papel));
    --g-destacado: var(--vino);
  }
  .g-etiqueta {
    font: 700 12px var(--sans);
    fill: var(--vino);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .g-tramo path {
    fill: none;
    stroke: var(--suave);
    stroke-width: 1.2;
  }
  .g-tramo text {
    font: 600 12.5px var(--sans);
    fill: var(--tinta);
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .g-base {
    stroke: var(--linea);
    stroke-width: 1;
  }
  .g-valor {
    font: 650 15px var(--sans);
    fill: var(--tinta);
  }
  .g-anio {
    font: 500 13px var(--sans);
    fill: var(--suave);
  }
  .g-barra {
    outline: none;
  }
  .g-barra path {
    transition: opacity 0.15s;
  }
  svg:has(.g-barra:hover) .g-barra:not(:hover) path,
  svg:has(.g-barra:focus-visible) .g-barra:not(:focus-visible) path {
    opacity: 0.45;
  }
  .g-tip {
    visibility: hidden;
    pointer-events: none;
  }
  .g-barra:hover .g-tip,
  .g-barra:focus-visible .g-tip {
    visibility: visible;
  }
  .g-tip div {
    background: var(--tinta);
    color: var(--fondo);
    border-radius: 8px;
    padding: 6px 10px;
    font: 13px/1.3 var(--sans);
    display: grid;
  }
  figcaption {
    font-size: 0.86rem;
    color: var(--suave);
    margin-top: 8px;
  }
  .g-tabla {
    margin-top: 10px;
    font-size: 0.92rem;
  }
  .g-tabla summary {
    cursor: pointer;
    color: var(--vino);
    font-weight: 600;
    margin-bottom: 8px;
  }
</style>
