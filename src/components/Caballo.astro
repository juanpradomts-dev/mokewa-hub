---
// Caballo del Ajedrez Club Mokewa, trazado sobre su logo público (foto de perfil de Facebook):
// silueta negra plana, ojo blanco redondo, corona naranja de 3 puntas y banda naranja en «<».
// Encuadre cuadrado y centrado para usarlo en medallones. Reemplazar por el vector oficial
// cuando el club lo entregue y autorice su uso.
interface Props {
  tam?: number | string;
  clase?: string;
  titulo?: string;
}
const { tam = 200, clase = "", titulo } = Astro.props;
const id = `banda-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class={`caballo ${clase}`}
  width={tam}
  height={tam}
  viewBox="66 -14 590 590"
  role={titulo ? "img" : undefined}
  aria-label={titulo}
  aria-hidden={titulo ? undefined : "true"}
>
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f7941d"></stop>
      <stop offset="0.55" stop-color="#f28a1e"></stop>
      <stop offset="1" stop-color="#e2700f"></stop>
    </linearGradient>
  </defs>
  <path class="banda" d="M185 150 L242 118 L168 378 L215 430 L322 556 L120 375 Z" fill={`url(#${id})`}></path>
  <path
    class="silueta"
    d="M278 62 L300 70 L410 70 L488 125 L498 150 L600 240 L602 296 L585 312 L550 316 L408 278 L500 468 L420 553 L322 556 L233 452 L220 372 L302 97 L297 80 Z"
    fill="#0b0b0b"
  ></path>
  <circle class="ojo" cx="419" cy="141" r="22" fill="#fff"></circle>
  <path class="corona" d="M300 70 L304 18 L336 46 L368 -2 L396 42 L426 4 L418 70 Z" fill="#f7941d"></path>
</svg>
