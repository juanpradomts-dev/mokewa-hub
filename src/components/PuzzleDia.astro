---
// Puzzle del día de Lichess dibujado como tablero propio (el marco oficial de Lichess es de tamaño fijo y muy pequeño).
// Los datos los guarda scripts/lichess.mjs en data/lichess/puzzle.json; se resuelve en Lichess.
import { existsSync, readFileSync } from "node:fs";
import path from "node:path";

const ruta = path.resolve("data/lichess/puzzle.json");
const datos = existsSync(ruta) ? JSON.parse(readFileSync(ruta, "utf8")) : null;
const p = datos?.puzzle;

const GLIFO: Record<string, string> = { k: "♚", q: "♛", r: "♜", b: "♝", n: "♞", p: "♟" };
const TEMAS: Record<string, string> = {
  opening: "apertura", middlegame: "medio juego", endgame: "final", advantage: "ventaja", crushing: "ventaja decisiva",
  mate: "mate", mateIn1: "mate en 1", mateIn2: "mate en 2", mateIn3: "mate en 3", trappedPiece: "pieza atrapada",
  fork: "horquilla", pin: "clavada", skewer: "enfilada", sacrifice: "sacrificio", discoveredAttack: "ataque a la descubierta",
  hangingPiece: "pieza colgada", defensiveMove: "jugada defensiva", deflection: "desviación", attraction: "atracción",
  quietMove: "jugada tranquila", promotion: "promoción", backRankMate: "mate del pasillo", kingsideAttack: "ataque al rey",
  short: "corto", long: "largo", veryLong: "muy largo", oneMove: "una jugada", rookEndgame: "final de torres",
  pawnEndgame: "final de peones", exposedKing: "rey expuesto", doubleCheck: "jaque doble", endgameTactic: "táctica de final",
};

let casillas: { x: number; y: number; oscura: boolean; marcada: boolean; pieza?: string; blanca?: boolean; nombre: string }[] = [];
let turno = "w";
if (p) {
  const [tablero, t] = p.fen.split(" ");
  turno = t;
  const filas = tablero.split("/");
  const girar = turno === "b"; // el tablero se muestra desde el lado que juega
  const marcadas = new Set([p.lastMove?.slice(0, 2), p.lastMove?.slice(2, 4)]);
  filas.forEach((fila: string, r: number) => {
    let c = 0;
    for (const ch of fila) {
      if (/\d/.test(ch)) {
        for (let k = 0; k < Number(ch); k++) agregar(r, c++);
      } else agregar(r, c++, ch);
    }
  });
  function agregar(r: number, c: number, ch?: string) {
    const nombre = "abcdefgh"[c] + (8 - r);
    const x = girar ? 7 - c : c;
    const y = girar ? 7 - r : r;
    casillas.push({
      x, y, nombre, oscura: (r + c) % 2 === 1, marcada: marcadas.has(nombre),
      pieza: ch ? GLIFO[ch.toLowerCase()] : undefined, blanca: ch ? ch === ch.toUpperCase() : undefined,
    });
  }
}
const temas = (p?.themes ?? []).map((t: string) => TEMAS[t]).filter(Boolean);
const juegan = turno === "w" ? "blancas" : "negras";
---

{p ? (
  <figure class="puzzle-dia">
    <svg viewBox="0 0 400 400" role="img" aria-label={`Puzzle del día: juegan las ${juegan}. Posición ${p.fen}`}>
      {casillas.map((s) => (
        <g>
          <rect x={s.x * 50} y={s.y * 50} width="50" height="50" class={`${s.oscura ? "osc" : "cla"}${s.marcada ? " marca" : ""}`} />
          {s.pieza && (
            <text x={s.x * 50 + 25} y={s.y * 50 + 38} text-anchor="middle" class={`pieza-svg glifo ${s.blanca ? "pb" : "pn"}`}>{s.pieza}</text>
          )}
        </g>
      ))}
    </svg>
    <figcaption>
      <span><strong>Juegan las {juegan}</strong> · dificultad {p.rating}</span>
      {temas.length > 0 && <span class="temas">{temas.slice(0, 3).join(" · ")}</span>}
    </figcaption>
    <a class="boton boton-primario" href={`https://lichess.org/training/${p.id}`} rel="noopener" target="_blank">Resolver en Lichess</a>
  </figure>
) : (
  <p>
    <a class="boton boton-primario" href="https://lichess.org/training/daily" rel="noopener" target="_blank">Ver el puzzle del día en Lichess</a>
  </p>
)}

<style>
  .puzzle-dia {
    margin: 0;
    display: grid;
    gap: 12px;
    justify-items: start;
  }
  svg {
    width: 100%;
    max-width: 420px;
    border-radius: 10px;
    display: block;
  }
  .cla {
    fill: #f0d9b5;
  }
  .osc {
    fill: #b58863;
  }
  .marca.cla {
    fill: #cdd26a;
  }
  .marca.osc {
    fill: #aaa23a;
  }
  .pieza-svg {
    font-size: 40px;
    font-variant-emoji: text;
  }
  .pb {
    fill: #fff;
    stroke: #1d1a17;
    stroke-width: 1.2px;
    paint-order: stroke;
  }
  .pn {
    fill: #1d1a17;
  }
  figcaption {
    display: grid;
    gap: 2px;
  }
  .temas {
    color: var(--suave);
    font-size: 0.9rem;
  }
</style>
