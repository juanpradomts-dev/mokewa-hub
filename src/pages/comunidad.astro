---
import Base from "../layouts/Base.astro";
import PuzzleDia from "../components/PuzzleDia.astro";
import club from "../data/club.json";
import { fechaLarga } from "../lib/formato.js";

const b = import.meta.env.BASE_URL.replace(/\/$/, "");
const ultimo = club.torneos.find((t) => t.id === club.ultimo);
const proximos = club.proximos.map((id) => club.torneos.find((x) => x.id === id)).filter(Boolean);

// Noticias de base: todas salen de datos verificados (Lichess o prensa, con su fuente).
const base = [
  ultimo && {
    fecha: ultimo.dia,
    titulo: `${ultimo.ganador} gana «${ultimo.nombre}»`,
    cuerpo: `${ultimo.jugadores} jugadores disputaron el último torneo online del club (${ultimo.ritmo.texto}). Podio: ${ultimo.podio.map((p) => `${p.puesto}.º ${p.u} (${p.puntos} pts)`).join(", ")}.`,
    fuente: ultimo.url,
    fuenteTexto: "Resultados en Lichess",
  },
  {
    fecha: "2026-09-17",
    fechaTexto: "septiembre de 2026",
    titulo: "Moquegua realiza su I Torneo Provincial de Ajedrez escolar",
    cuerpo: "La Municipalidad Provincial Mariscal Nieto organizó el primer torneo provincial para escolares de 6 a 17 años, con 156 estudiantes de 12 primarias y 14 secundarias.",
    fuente: "https://munimoquegua.gob.pe/estudiantes-moqueguanos-convierten-nuestra-plaza-en-capital-del-deporte-ciencia/",
    fuenteTexto: "Municipalidad Provincial Mariscal Nieto",
    entorno: true,
  },
  {
    fecha: "2026-07-24",
    titulo: "Un ajedrecista sub-12 de Moquegua va al Festival Panamericano de la Juventud",
    cuerpo: "El Fondo de Apoyo Económico para Deportistas Destacados otorgó S/ 3 000 a un ajedrecista moqueguano sub-12 clasificado al Festival Panamericano de la Juventud, en Medellín.",
    fuente: "https://prensaregional.pe/",
    fuenteTexto: "La Prensa Regional",
    entorno: true,
  },
].filter(Boolean);
---

<Base titulo="Comunidad" seccion="comunidad" descripcion="Torneos online del Ajedrez Club Mokewa en Lichess, puzzle del día y noticias del club.">
  <section class="seccion">
    <div class="contenedor">
      <p class="antetitulo">Comunidad</p>
      <h1>Juega con el club todo el año</h1>
      <p class="bajada">El equipo «{club.equipo.nombre}» en Lichess reúne a {club.equipo.miembros} miembros. Lichess es gratuito, sin publicidad y funciona en el celular.</p>

      <div class="comunidad-grid">
        <div class="tarjeta">
          <h2 class="h-bloque">Torneos online del equipo</h2>
          {proximos.length ? (
            <ul class="proximos">
              {proximos.map((p) => (
                <li><a href={p.url} rel="noopener" target="_blank"><strong>{p.nombre}</strong><span>{fechaLarga(p.dia)} · {p.ritmo.texto}</span></a></li>
              ))}
            </ul>
          ) : (
            <p class="suave">No hay torneos online programados ahora mismo. Cuando el club cree uno en Lichess, aparece aquí solo (se revisa cada hora).</p>
          )}
          <ol class="pasos">
            <li>Crea tu cuenta gratis en <a href="https://lichess.org/signup" rel="noopener" target="_blank">Lichess</a>.</li>
            <li>Pide tu ingreso al <a href={club.equipo.url} rel="noopener" target="_blank">equipo del club</a>.</li>
            <li>Recibe los torneos y juega desde el celular.</li>
          </ol>
          <a class="boton boton-primario" href={club.equipo.url} rel="noopener" target="_blank">Unirme al equipo</a>
        </div>
        <div class="tarjeta puzzle">
          <h2 class="h-bloque">Puzzle del día</h2>
          <PuzzleDia />
          <p class="suave">Cortesía de Lichess. Cambia cada día.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <h2>Noticias</h2>
      <div class="noticias" id="noticias">
        {base.map((n) => (
          <article class="tarjeta noticia">
            <p class="meta">{n.fechaTexto ?? fechaLarga(n.fecha)}{n.entorno && <span class="etiqueta">Ajedrez en Moquegua</span>}</p>
            <h3>{n.titulo}</h3>
            <p>{n.cuerpo}</p>
            <a class="fuente" href={n.fuente} rel="noopener" target="_blank">Fuente: {n.fuenteTexto}</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  import { noticias, alCambiar } from "../lib/store.js";
  import { esc } from "../lib/html.js";
  import { fechaLarga } from "../lib/formato.js";

  const caja = document.getElementById("noticias")!;
  function pintar() {
    caja.querySelectorAll("[data-panel]").forEach((n) => n.remove());
    for (const n of noticias().reverse()) {
      const art = document.createElement("article");
      art.className = "tarjeta noticia";
      art.dataset.panel = "1";
      art.innerHTML = `<p class="meta">${fechaLarga(n.fecha)} <span class="etiqueta etiqueta-ok">Publicada desde el panel</span></p><h3>${esc(n.titulo)}</h3><p>${esc(n.cuerpo).replace(/\n/g, "<br>")}</p>`;
      caja.prepend(art);
    }
  }
  pintar();
  alCambiar(pintar);
</script>

<style>
  .comunidad-grid {
    display: grid;
    gap: 16px;
    margin-top: 24px;
  }
  @media (min-width: 900px) {
    .comunidad-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .h-bloque {
    font-size: 1.3rem;
  }
  .suave {
    color: var(--suave);
    font-size: 0.93rem;
  }
  .proximos {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .proximos a {
    display: grid;
    padding: 10px 12px;
    border-radius: 10px;
    background: var(--casilla);
    text-decoration: none;
    color: var(--tinta);
  }
  .pasos {
    padding-left: 1.3em;
    margin: 16px 0 20px;
  }
  .pasos li {
    margin-bottom: 6px;
  }
  .noticias {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 900px) {
    .noticias {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  :global(.noticia h3) {
    font-size: 1.2rem;
  }
  :global(.noticia .meta) {
    font-size: 0.85rem;
    color: var(--suave);
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 6px;
  }
  .fuente {
    font-size: 0.85rem;
  }
</style>
