---
import Dato from "../components/Dato.astro";
import Base from "../layouts/Base.astro";
import BotonContacto from "../components/BotonContacto.astro";
import club from "../data/club.json";
import NivelTarjeta from "../components/NivelTarjeta.astro";
import { NIVELES } from "../lib/niveles.js";
import { valor, esProduccion } from "../lib/contenido.js";

const b = import.meta.env.BASE_URL.replace(/\/$/, "");

// Preguntas frecuentes. Las que dependen de un dato del club se ocultan en producción si falta.
const preguntas = [
  { p: "¿Desde qué edad pueden empezar?", campo: "edad_minima" },
  { p: "¿Cuánto cuesta?", antes: "Mensualidad: ", campo: "precio_mensual", despues: ". Se paga por Yape o Plin." },
  { p: "¿Dónde son las clases?", antes: "En la sede del club: ", campo: "sede", despues: "." },
  { p: "¿Cómo sé en qué nivel inscribir a mi hijo o hija?", r: "Si nunca ha jugado, en básico. Si ya juega o compite, escríbenos y el club te recomienda el nivel." },
  { p: "¿Pueden practicar en casa?", r: `Sí: el club tiene un equipo gratuito en Lichess con ${club.equipo.miembros} miembros donde se juegan torneos en línea desde el celular.` },
  { p: "¿Hay torneos para alumnos?", r: "Sí. El club organiza torneos por nivel (básico, intermedio y avanzado) y en 2024 organizó un torneo oficial válido para el rating FIDE." },
].filter((q) => !q.campo || valor(q.campo) || !esProduccion);
---

<Base titulo="Academia" seccion="academia" descripcion="Clases de ajedrez en Moquegua por niveles: básico, intermedio y avanzado. Horarios, precios e inscripción.">
  <section class="seccion cabeza">
    <div class="contenedor">
      <p class="antetitulo">Academia</p>
      <h1>Clases de ajedrez en Moquegua, por niveles</h1>
      <p class="bajada">
        Tres niveles —básico, intermedio y avanzado—, los mismos que el club usa en sus torneos por nivel.
      </p>
      <div class="grupo-botones">
        <BotonContacto accion="Pedir informes" mensaje="Hola, quisiera inscribir a mi hijo/a en la academia de ajedrez. ¿Qué horarios tienen?" />
        <a class="boton boton-secundario" href="#preguntas">Preguntas frecuentes</a>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor rejilla rejilla-3">
      {NIVELES.map((n) => <NivelTarjeta nivel={n} titulo="h2" />)}
    </div>
  </section>


  <section class="seccion" id="preguntas">
    <div class="contenedor">
      <h2>Preguntas frecuentes</h2>
      <div class="faq">
        {preguntas.map((q) => (
          <details class="tarjeta">
            <summary>{q.p}</summary>
            <p>{q.r ?? <>{q.antes}<Dato campo={q.campo} />{q.despues}</>}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .cabeza {
    background: linear-gradient(180deg, #fde7d1, var(--fondo) 70%);
  }
  .faq {
    display: grid;
    gap: 10px;
    max-width: 780px;
  }
  .faq details {
    padding: 0;
  }
  .faq summary {
    cursor: pointer;
    padding: 16px 20px;
    font-weight: 600;
    list-style-position: inside;
  }
  .faq p {
    padding: 0 20px 16px;
    margin: 0;
    color: var(--suave);
  }
</style>
