---
import Base from "../layouts/Base.astro";
import club from "../data/club.json";
import { fechaLarga, miles } from "../lib/formato.js";

import { esProduccion } from "../lib/contenido.js";
const b = import.meta.env.BASE_URL.replace(/\/$/, "");
// Explica la demo: en la web oficial no existe.
if (esProduccion) return Astro.redirect(`${b}/`);
const t = club.totales;
const pantallas = [
  ["Inicio", "Quiénes somos, misión y visión, los tres niveles de la academia y por qué elegir el club.", "Real; misión y visión son una propuesta", "mixto"],
  ["Academia", "Niveles básico, intermedio y avanzado, con lo que aprende cada uno y preguntas frecuentes.", "Niveles reales; contenidos, horarios y precios por confirmar", "mixto"],
  ["Torneos", "Solo torneos presenciales: el II IRT FIDE de 2024 y un «Torneo de Verano 2027» de ejemplo con la inscripción funcionando.", "Real + ejemplo marcado", "mixto"],
  ["El Club", "Nuestra historia: los campeones de los torneos presenciales del club, año por año, y la comunidad en Lichess.", "Real (Chess-Results); victorias en torneos de otros organizadores por confirmar", "mixto"],
  ["Inscripción y panel", "Formulario, carga de comprobante y panel con inicio de sesión por roles: administrador (todo) y entrenador (torneos, resultados y noticias).", "Funcional, con cuentas y datos de prueba", "prueba"],
  ["Contacto", "Facebook, Lichess, sede y WhatsApp.", "Facebook y Lichess verificados; lo demás por confirmar", "prueba"],
];
const fuentes = [
  ["Ajedrez Club Mokewa en Facebook", "https://www.facebook.com/ACMokewa/"],
  ["Equipo «Ajedrez Club Mokewa» en Lichess (API pública)", "https://lichess.org/api/team/ajedrez-club-mokewa"],
  ["FIDE Ratings: II IRT Clásico Cerrado «Ajedrez Club Mokewa», enero de 2024", "https://ratings.fide.com/report.phtml?event=350802"],
  ["Chess-Results: clasificaciones de los torneos presenciales del club (2022–2026), enlazadas una a una en «Nuestra historia»", "https://chess-results.com/"],
  ["Radio Sol 94.5 FM (20-08-2021): «Promocionan Festival Ajedrez Club Moquegua», con la página de Facebook Ajedrez Club Mokewa", "https://www.radiosol.com.pe/promocionan-festival-ajedrez-club-moquegua.html"],
  ["Municipalidad de Mariscal Nieto: I Torneo Provincial de Ajedrez 2026 (156 escolares de 26 colegios)", "https://munimoquegua.gob.pe/estudiantes-moqueguanos-convierten-nuestra-plaza-en-capital-del-deporte-ciencia/"],
];
---

<Base titulo="Acerca de esta demo" descripcion="Qué es esta demostración, qué datos son reales y qué falta para publicarla como web oficial.">
  <section class="seccion">
    <div class="contenedor texto">
      <p class="antetitulo">Acerca de esta demo</p>
      <h1>Una web hecha con la historia real del club</h1>
      <p class="bajada">
        Esta es una demostración funcional preparada sin costo para el Ajedrez Club Mokewa. Usa solo datos públicos verificables y no se difunde ni se presenta como web oficial hasta que el club la apruebe.
      </p>

      <div class="cifras">
        <div class="cifra"><strong>{t.desde}</strong><span>primer torneo del club en Lichess</span></div>
        <div class="cifra"><strong>{miles(club.equipo.miembros)}</strong><span>miembros en su equipo de Lichess</span></div>
        <div class="cifra"><strong>FIDE</strong><span>torneo oficial organizado en 2024</span></div>
        <div class="cifra"><strong>S/ 0</strong><span>costo de la infraestructura</span></div>
      </div>

      <h2>Qué es real y qué es ejemplo</h2>
      <div class="tabla-envoltura" tabindex="0" role="region" aria-label="Qué es real y qué es ejemplo">
        <table>
          <thead><tr><th>Pantalla</th><th>Contenido</th><th>Estado del dato</th></tr></thead>
          <tbody>
            {pantallas.map(([p, c, e, tipo]) => (
              <tr><td><strong>{p}</strong></td><td>{c}</td><td><span class={`etiqueta ${tipo === "ok" ? "etiqueta-ok" : "etiqueta-ejemplo"}`}>{e}</span></td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>Lo que falta del club</h2>
      <ol class="cinco">
        <li>WhatsApp oficial, dirección de la sede y horario de atención.</li>
        <li>Horarios, precios y edades de cada nivel de la academia.</li>
        <li>Autorización para usar el logo (y el archivo original).</li>
        <li>Victorias en torneos presenciales oficiales: torneo, fecha, puesto y categoría.</li>
        <li>Fotos de torneos y clases, con autorización escrita de los padres.</li>
        <li>Entrenadores, y aprobar o ajustar la misión y la visión.</li>
      </ol>
      <p>Todo lo marcado <span class="pc">por confirmar</span> se completa en segundos desde el <a href={`${b}/panel/`}>panel del organizador</a>, pestaña «Datos del club».</p>

      <h2>Privacidad en la demo</h2>
      <p>De los campeones, la web muestra solo el nombre y la inicial del apellido; ninguna foto de alumnos. Los inscritos del «Torneo de Verano 2027» son nombres de ejemplo, y lo que escribas en los formularios se guarda únicamente en tu navegador. La página no se indexa en buscadores.</p>

      <h2>Fuentes</h2>
      <ul class="fuentes">
        {fuentes.map(([txt, url]) => <li><a href={url} rel="noopener" target="_blank">{txt}</a></li>)}
      </ul>
      <p class="suave">Datos de Lichess actualizados al {fechaLarga(club.actualizado_en.slice(0, 10))}.</p>
    </div>
  </section>
</Base>

<style>
  .texto {
    max-width: 900px;
  }
  .cifras {
    margin: 24px 0;
  }
  h2 {
    font-size: 1.45rem;
    margin-top: 1.6em;
  }
  .cinco li,
  .fuentes li {
    margin-bottom: 6px;
  }
  .suave {
    color: var(--suave);
    font-size: 0.9rem;
  }
</style>
