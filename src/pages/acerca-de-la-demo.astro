---
import Base from "../layouts/Base.astro";
import club from "../data/club.json";
import { fechaLarga, miles } from "../lib/formato.js";

const b = import.meta.env.BASE_URL.replace(/\/$/, "");
const t = club.totales;
const pantallas = [
  ["Inicio", "Historia del club, contador de jugadores y torneos, próximo evento.", "Real (Lichess, FIDE, prensa)", "ok"],
  ["Torneos", `Los ${t.torneos} torneos online del club y un «Torneo de Verano 2027» con inscripción funcionando.`, "Real + ejemplo marcado", "mixto"],
  ["Inscripción y panel", "Formulario, carga de comprobante y la vista del organizador validando pagos.", "Funcional, con datos de prueba", "prueba"],
  ["Academia", "Niveles básico, intermedio y avanzado (los que el club usa en sus torneos híbridos).", "Niveles reales; horarios y precios por confirmar", "mixto"],
  ["Contacto", "WhatsApp, sede y redes.", "Por confirmar (solo Facebook y Lichess verificados)", "prueba"],
];
const fuentes = [
  ["Ajedrez Club Mokewa en Facebook", "https://www.facebook.com/ACMokewa/"],
  ["Equipo «Ajedrez Club Mokewa» en Lichess (API pública)", "https://lichess.org/api/team/ajedrez-club-mokewa"],
  ["FIDE Ratings: II IRT Clásico Cerrado «Ajedrez Club Mokewa», enero de 2024", "https://ratings.fide.com/report.phtml?event=350802"],
  ["Radio Sol 94.5 FM: Festival Ajedrez Club Moquegua (2021)", "https://www.radiosol.com.pe/promocionan-festival-ajedrez-club-moquegua.html"],
  ["Municipalidad Provincial Mariscal Nieto: I Torneo Provincial de Ajedrez (2026)", "https://munimoquegua.gob.pe/estudiantes-moqueguanos-convierten-nuestra-plaza-en-capital-del-deporte-ciencia/"],
  ["La Prensa Regional: I Torneo Provincial de Ajedrez (2026)", "https://prensaregional.pe/primer-torneo-provincial-de-ajedrez-reunira-a-escolares-en-moquegua/"],
];
---

<Base titulo="Acerca de esta demo" descripcion="Qué es esta demostración, qué datos son reales y qué falta para publicarla como web oficial.">
  <section class="seccion">
    <div class="contenedor texto">
      <p class="antetitulo">Acerca de esta demo</p>
      <h1>Una web hecha con la historia real del club</h1>
      <p class="bajada">
        Esta es una demostración funcional preparada sin costo para el Ajedrez Club Mokewa. Usa solo datos públicos verificables y no se difunde ni se presenta como web oficial hasta que el club la apruebe.
      </p>

      <div class="cifras">
        <div class="cifra"><strong>{t.torneos}</strong><span>torneos leídos de Lichess</span></div>
        <div class="cifra"><strong>{miles(t.jugadores)}</strong><span>jugadores distintos</span></div>
        <div class="cifra"><strong>{t.campeones}</strong><span>campeones calculados</span></div>
        <div class="cifra"><strong>S/ 0</strong><span>costo de la infraestructura</span></div>
      </div>

      <h2>Qué es real y qué es ejemplo</h2>
      <div class="tabla-envoltura">
        <table>
          <thead><tr><th>Pantalla</th><th>Contenido</th><th>Estado del dato</th></tr></thead>
          <tbody>
            {pantallas.map(([p, c, e, tipo]) => (
              <tr><td><strong>{p}</strong></td><td>{c}</td><td><span class={`etiqueta ${tipo === "ok" ? "etiqueta-ok" : "etiqueta-ejemplo"}`}>{e}</span></td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>Solo faltan cinco datos del club</h2>
      <ol class="cinco">
        <li>Horarios de la academia.</li>
        <li>Precios (mensualidad e inscripciones).</li>
        <li>Dirección de la sede.</li>
        <li>WhatsApp oficial.</li>
        <li>Autorización para usar el logo.</li>
      </ol>
      <p>Todo lo marcado <span class="pc">por confirmar</span> se completa en segundos desde el <a href={`${b}/panel/`}>panel del organizador</a>, pestaña «Datos del club».</p>

      <h2>Privacidad en la demo</h2>
      <p>Solo se muestran nombres de usuario públicos de Lichess: ningún nombre real ni foto. Las inscripciones que hagas aquí se guardan únicamente en tu navegador. La página no se indexa en buscadores.</p>

      <h2>Fuentes</h2>
      <ul class="fuentes">
        {fuentes.map(([txt, url]) => <li><a href={url} rel="noopener" target="_blank">{txt}</a></li>)}
      </ul>
      <p class="suave">Datos de Lichess actualizados al {fechaLarga(club.actualizado_en.slice(0, 10))}.</p>
    </div>
  </section>
</Base>

<style>
  .texto {
    max-width: 900px;
  }
  .cifras {
    margin: 24px 0;
  }
  h2 {
    font-size: 1.45rem;
    margin-top: 1.6em;
  }
  .cinco li,
  .fuentes li {
    margin-bottom: 6px;
  }
  .suave {
    color: var(--suave);
    font-size: 0.9rem;
  }
</style>
