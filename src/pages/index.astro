---
// Portada: el público principal es el padre de familia. Máximo 5 secciones:
// héroe · quiénes somos · academia · por qué Mokewa · cierre.
import Base from "../layouts/Base.astro";
import Caballo from "../components/Caballo.astro";
import BotonContacto from "../components/BotonContacto.astro";
import NivelTarjeta from "../components/NivelTarjeta.astro";
import Equipo from "../components/Equipo.astro";
import QuienesSomos from "../components/QuienesSomos.astro";
import { LEMA } from "../lib/club.js";
import Dato from "../components/Dato.astro";
import club from "../data/club.json";
import { NIVELES } from "../lib/niveles.js";
import { valor } from "../lib/contenido.js";

const b = import.meta.env.BASE_URL.replace(/\/$/, "");
const t = club.totales;
const anioActual = Number(club.actualizado_en.slice(0, 4));
const anios = anioActual - t.desde; // desde el primer torneo online registrado (cota inferior)
const mapa = valor("mapa");
---

<Base titulo="Inicio" seccion="inicio" descripcion="Academia de ajedrez en Moquegua: clases por niveles, torneos todo el año y una comunidad que compite desde 2020.">
  <!-- 1. HÉROE -->
  <section class="heroe">
    <div class="contenedor heroe-grid">
      <div class="escena" data-viaje-desde aria-hidden="true">
        <div class="halo"></div>
        <div class="viajero">
          <div class="flotante">
            <div class="moneda">
              <div class="cara"><Caballo tam="100%" /></div>
              {Array.from({ length: 9 }, (_, i) => <div class="canto" style={`--i:${i + 1}`}></div>)}
              <div class="dorso"><Caballo tam="100%" /></div>
            </div>
          </div>
        </div>
        <div class="sombra"></div>
      </div>
      <div class="heroe-texto">
        <p class="antetitulo">Academia de ajedrez en Moquegua</p>
        <h1>Que tu hijo gane concentración, disciplina y ganas de competir</h1>
        <p class="heroe-lema">«{LEMA}»</p>
        <p class="heroe-bajada">Clases por niveles y torneos con el Ajedrez Club Mokewa, en Moquegua.</p>
        <div class="grupo-botones">
          <BotonContacto cta />
          <a class="boton boton-secundario" href={`${b}/torneos/`}>Ver torneos</a>
        </div>
        <dl class="prueba-social">
          <div><dt>+{anios} años</dt><dd>organizando torneos (desde {t.desde})</dd></div>
          <div><dt>3 niveles</dt><dd>básico, intermedio y avanzado</dd></div>
          <div><dt>FIDE</dt><dd><a href="https://ratings.fide.com/report.phtml?event=350802" rel="noopener" target="_blank">torneo oficial con rating</a> en 2024</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- 2. QUIÉNES SOMOS -->
  <section class="seccion" id="quienes-somos">
    <div class="contenedor"><QuienesSomos /></div>
  </section>

  <!-- 3. ACADEMIA -->
  <section class="seccion seccion-durazno" id="academia">
    <div class="contenedor">
      <div class="encabezado">
        <div>
          <p class="antetitulo">Academia</p>
          <h2>Clases por niveles</h2>
        </div>
        <a class="ver-mas" href={`${b}/academia/`}>Ver la academia →</a>
      </div>
      <p class="deslizar" aria-hidden="true">Desliza para ver los 3 niveles →</p>
      <div class="carrusel" tabindex="0" aria-label="Niveles de la academia">
        {NIVELES.map((n) => <NivelTarjeta nivel={n} />)}
      </div>
    </div>
  </section>

  <!-- 4. POR QUÉ MOKEWA -->
  <section class="seccion seccion-naranja por-que">
    <div class="contenedor">
      <div class="por-que-grid">
        <div class="por-que-cabeza">
          <p class="antetitulo">Por qué Mokewa</p>
          <h2>Un club que compite, no solo una clase</h2>
        </div>
        <div class="pista" data-viaje-hasta aria-hidden="true">
          <svg class="adornos" viewBox="0 0 200 200">
            <circle class="aro aro-1" cx="100" cy="100" r="92"></circle>
            <circle class="aro aro-2" cx="100" cy="100" r="74"></circle>
            <rect class="casilla-deco c1" x="14" y="30" width="12" height="12"></rect>
            <rect class="casilla-deco c2" x="172" y="56" width="9" height="9"></rect>
            <rect class="casilla-deco c3" x="160" y="160" width="12" height="12"></rect>
            <circle class="punto" cx="36" cy="164" r="4"></circle>
            <circle class="punto" cx="182" cy="120" r="3"></circle>
            <circle class="punto" cx="120" cy="10" r="3"></circle>
          </svg>
        </div>
      <ul class="razones">
        <li class="razon">
          <span class="razon-icono glifo" aria-hidden="true">♜&#xfe0e;</span>
          <div>
            <h3>Compite con rivales de su nivel</h3>
            <p>Torneos por nivel (básico, intermedio y avanzado): cada alumno mide su progreso contra rivales de su nivel.</p>
          </div>
        </li>
        <li class="razon">
          <span class="razon-icono glifo" aria-hidden="true">♚&#xfe0e;</span>
          <div>
            <h3>Torneo oficial FIDE</h3>
            <p>El club organizó el II IRT Clásico Cerrado «Ajedrez Club Mokewa» (2024), válido para rating FIDE.</p>
          </div>
        </li>
        <li class="razon">
          <span class="razon-icono glifo" aria-hidden="true">♞&#xfe0e;</span>
          <div>
            <h3>Donde el ajedrez nunca descansa</h3>
            <p>Entre clase y clase se sigue jugando: el club tiene un equipo en Lichess con {club.equipo.miembros} miembros.</p>
          </div>
        </li>
      </ul>
      </div>
      <Equipo sobreNaranja />
    </div>
  </section>

  <!-- 5. CIERRE -->
  <section class="seccion cierre-seccion">
    <div class="contenedor">
      <div class="cierre tarjeta">
        <div>
          <h2>La primera jugada: escríbenos</h2>
          <p>Te contamos horarios, niveles y cómo empezar.</p>
          <Dato como="p" etiqueta="Sede" campo="sede" />
          {mapa && <a class="mapa" href={mapa} rel="noopener" target="_blank">Ver en Google Maps</a>}
        </div>
        <BotonContacto cta />
      </div>
    </div>
  </section>
</Base>

<script>
  // Caballo viajero: del héroe a «Por qué Mokewa», girando con el scroll.
  import { iniciarViaje } from "../lib/viajero.js";
  iniciarViaje();
</script>

<style>
  /* ---------- 1. Héroe ---------- */
  .heroe {
    padding: 28px 0 44px;
    background:
      radial-gradient(circle at 85% 30%, rgb(242 138 30 / 0.28), transparent 45%),
      radial-gradient(circle at 5% 100%, rgb(247 165 74 / 0.25), transparent 40%),
      linear-gradient(180deg, #fff4e8, #fde7d1);
    position: relative;
    overflow: hidden;
  }
  .heroe::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: conic-gradient(rgb(166 75 8 / 0.06) 25%, transparent 0 50%, rgb(166 75 8 / 0.06) 0 75%, transparent 0);
    background-size: 64px 64px;
    mask-image: linear-gradient(90deg, transparent, #000 60%);
    pointer-events: none;
  }
  .heroe > .contenedor {
    position: relative;
  }
  .heroe-grid {
    display: grid;
    gap: 20px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .heroe {
      padding: 72px 0 80px;
    }
    .heroe-grid {
      grid-template-columns: 1.5fr 1fr;
      gap: 48px;
    }
    .escena {
      order: 2;
    }
  }
  .heroe h1 {
    color: var(--tinta);
    font-size: clamp(2rem, 6.2vw, 3.3rem);
  }
  .heroe-lema {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.2rem;
    color: #a64b08;
    margin: -0.2em 0 0.4em;
  }
  .heroe-bajada {
    font-size: 1.12rem;
    color: var(--suave);
    max-width: 52ch;
    margin-bottom: 1.4em;
  }
  .prueba-social {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 32px 0 0;
    padding-top: 20px;
    border-top: 1px solid rgb(166 75 8 / 0.2);
    max-width: 560px;
  }
  .prueba-social div {
    border-left: 3px solid var(--oro);
    padding-left: 10px;
  }
  .prueba-social dt {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 5vw, 2rem);
    font-weight: 650;
    color: var(--tinta);
    line-height: 1.1;
  }
  .prueba-social dd {
    margin: 4px 0 0;
    font-size: 0.84rem;
    color: var(--suave);
    line-height: 1.35;
  }

  /* ---------- Caballo viajero (moneda 3D) ----------
     Nace en el héroe y aterriza en «Por qué Mokewa» (src/lib/viajero.js).
     El balanceo en bucle es suave y de poca amplitud: se ve para todos. */
  .escena {
    position: relative;
    width: min(32vw, 124px);
    aspect-ratio: 1;
    justify-self: center;
  }
  @media (min-width: 900px) {
    .escena {
      width: 280px;
    }
  }
  .halo {
    position: absolute;
    inset: -10%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(242 138 30 / 0.3), rgb(242 138 30 / 0.07) 50%, transparent 68%);
    opacity: var(--salida, 1);
  }
  .sombra {
    position: absolute;
    left: 27%;
    bottom: -6%;
    width: 46%;
    height: 7%;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
    filter: blur(6px);
    animation: sombra 5.5s ease-in-out infinite;
    opacity: var(--salida, 1);
  }
  .viajero {
    position: absolute;
    inset: 0;
  }
  :global(.viajero.en-viaje) {
    position: absolute;
    inset: auto;
    left: 0;
    top: 0;
    z-index: 15;
    pointer-events: none;
    transform-origin: 0 0;
    will-change: transform;
  }
  .flotante {
    width: 100%;
    height: 100%;
    perspective: 900px;
    animation: flotar 5.5s ease-in-out infinite;
  }
  .moneda {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(calc(var(--giro, 0deg) + var(--ry, 0deg))) rotateZ(var(--inclina, 0deg));
    transition: transform 0.2s ease-out;
  }
  .cara,
  .dorso,
  .canto {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }
  .cara,
  .dorso {
    display: grid;
    place-items: center;
    padding: 12%;
    backface-visibility: hidden;
  }
  .cara {
    background: radial-gradient(circle at 35% 30%, #ffffff, #efe9e1 72%);
    box-shadow: inset 0 0 0 5px #f28a1e, 0 26px 40px rgb(0 0 0 / 0.45);
  }
  .canto {
    background: #d9700f;
    transform: translateZ(calc(var(--i) * -1.6px));
  }
  .dorso {
    background: #141211;
    box-shadow: inset 0 0 0 5px #f28a1e;
    transform: translateZ(-16px) rotateY(180deg);
  }
  .dorso :global(.silueta) {
    fill: #f7941d;
  }
  .dorso :global(.banda),
  .dorso :global(.corona) {
    fill: #fff;
  }
  .dorso :global(.ojo) {
    fill: #141211;
  }
  .cara :global(svg),
  .dorso :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
  .cara :global(.corona) {
    transform-box: view-box;
    transform-origin: 360px 70px;
    animation: corona 5.5s ease-in-out infinite;
  }
  @keyframes flotar {
    0%, 100% { translate: 0 0; rotate: -2deg; }
    50% { translate: 0 -12px; rotate: 1.5deg; }
  }
  @keyframes corona {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(-4deg) translateY(-6px); }
  }
  @keyframes sombra {
    0%, 100% { transform: scaleX(1); opacity: 0.55; }
    50% { transform: scaleX(0.78); opacity: 0.3; }
  }

  /* ---------- «Por qué Mokewa» con la pista de aterrizaje ---------- */
  .por-que-grid {
    display: grid;
    grid-template-columns: 1fr 104px;
    gap: 0 16px;
    align-items: start;
  }
  .por-que-cabeza h2 {
    margin: 0;
  }
  .pista {
    position: relative;
    width: 104px;
    aspect-ratio: 1;
    justify-self: end;
  }
  .por-que-grid .razones {
    grid-column: 1 / -1;
  }
  @media (min-width: 900px) {
    .por-que-grid {
      grid-template-columns: 1.2fr 1fr;
      grid-template-areas: "cabeza pista" "razones pista";
      gap: 0 56px;
    }
    .por-que-cabeza {
      grid-area: cabeza;
    }
    .pista {
      grid-area: pista;
      width: 300px;
      justify-self: center;
      align-self: center;
    }
    .por-que-grid .razones {
      grid-area: razones;
      grid-column: auto;
      grid-template-columns: 1fr;
    }
  }
  .adornos {
    position: absolute;
    inset: -18%;
    width: 136%;
    height: 136%;
    overflow: visible;
  }
  .aro {
    fill: none;
    stroke: rgb(20 18 17 / 0.3);
    stroke-width: 1.2;
    transition: stroke 0.4s;
    transform-origin: 100px 100px;
  }
  .aro-2 {
    stroke: rgb(255 255 255 / 0.6);
    stroke-dasharray: 3 5;
  }
  .casilla-deco {
    fill: none;
    stroke: #fff;
    stroke-width: 1.4;
    transform-box: fill-box;
    transform-origin: center;
    animation: deriva 7s ease-in-out infinite;
  }
  .c2 {
    animation-delay: -2s;
  }
  .c3 {
    animation-delay: -4s;
  }
  .punto {
    fill: #141211;
    opacity: 0.35;
  }
  @keyframes deriva {
    0%, 100% { transform: translateY(0) rotate(45deg); }
    50% { transform: translateY(-6px) rotate(90deg); }
  }
  .pista:global(.aterrizado) .aro-1 {
    stroke: #141211;
    animation: aterriza 0.7s ease-out;
  }
  @keyframes aterriza {
    from { transform: scale(0.8); opacity: 0.2; }
    to { transform: scale(1); opacity: 1; }
  }

  /* ---------- encabezados de sección ---------- */
  .encabezado {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 4px 20px;
    margin-bottom: 20px;
  }
  .encabezado h2 {
    margin: 0;
    max-width: 22ch;
  }
  .ver-mas {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }

  /* ---------- 2. Academia: carrusel en móvil, 3 columnas en escritorio ---------- */
  .deslizar {
    font-size: 0.85rem;
    color: var(--suave);
    margin: -8px 0 10px;
  }
  .carrusel {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 84%;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px 2px 12px;
    scrollbar-width: thin;
  }
  .carrusel > :global(*) {
    scroll-snap-align: start;
  }
  @media (min-width: 820px) {
    .deslizar {
      display: none;
    }
    .carrusel {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      overflow: visible;
    }
  }

  /* ---------- 3. Por qué Mokewa ---------- */
  .razones {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  @media (min-width: 860px) {
    .razones {
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }
  }
  .razon {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 14px;
    align-items: start;
  }
  .razon h3 {
    margin: 4px 0 4px;
    font-size: 1.15rem;
  }
  .razon p {
    margin: 0;
    color: var(--suave);
    font-size: 0.97rem;
  }
  .razon-icono {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: #fff;
    color: #141211;
    font-size: 1.8rem;
    box-shadow: 0 6px 16px rgb(90 42 6 / 0.18);
  }

  /* ---------- 5. Cierre ---------- */
  .cierre {
    display: grid;
    gap: 16px;
    align-items: center;
    padding: 22px;
    background: linear-gradient(135deg, #fff4e8, #fde7d1);
    border: 0;
    border-left: 6px solid var(--oro);
  }
  @media (min-width: 860px) {
    .cierre {
      grid-template-columns: 1fr auto;
      padding: 36px 40px;
    }
  }
  .cierre h2 {
    margin-bottom: 6px;
  }
  .cierre p {
    margin: 0 0 8px;
    color: var(--suave);
  }
  .mapa {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }
</style>
