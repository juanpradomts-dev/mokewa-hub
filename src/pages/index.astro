---
// Portada: el público principal es el padre de familia. Máximo 5 secciones:
// héroe · quiénes somos · academia · por qué Mokewa · cierre.
import Base from "../layouts/Base.astro";
import Caballo from "../components/Caballo.astro";
import BotonContacto from "../components/BotonContacto.astro";
import NivelTarjeta from "../components/NivelTarjeta.astro";
import Equipo from "../components/Equipo.astro";
import QuienesSomos from "../components/QuienesSomos.astro";
import { LEMA } from "../lib/club.js";
import Dato from "../components/Dato.astro";
import club from "../data/club.json";
import { NIVELES } from "../lib/niveles.js";
import { valor } from "../lib/contenido.js";
import historia from "../data/historia.json";

const b = import.meta.env.BASE_URL.replace(/\/$/, "");
const t = club.totales;
const anioActual = Number(club.actualizado_en.slice(0, 4));
const anios = anioActual - t.desde; // desde el primer torneo online registrado (cota inferior)
const mapa = valor("mapa");
// Cifras de la historia presencial (Chess-Results), redondeadas: la web habla en general.
const torneosPresenciales = historia.torneos.reduce((n, e) => n + e.fuentes.length, 0);
const campeones = new Set(historia.torneos.flatMap((e) => e.campeones.map((c) => c.nombre)).filter((n) => !n.startsWith("Equipo"))).size;
const redondeo = (n: number) => (n >= 20 ? `+${Math.floor(n / 10) * 10}` : String(n));
---

<Base titulo="Inicio" seccion="inicio" descripcion="Ajedrez Club Mokewa, donde el ajedrez nunca descansa: academia en Moquegua con clases y torneos presenciales para niños, jóvenes y adultos.">
  <!-- 1. HÉROE -->
  <section class="heroe">
    <div class="piezas-fondo" aria-hidden="true">
      <span class="pieza-deco glifo" style="--x:46%;--y:8%;--t:1.8rem;--p:1.1;--r:10deg">♝&#xfe0e;</span>
      <span class="pieza-deco glifo" style="--x:92%;--y:78%;--t:2.2rem;--p:0.8;--r:14deg">♜&#xfe0e;</span>
      <span class="pieza-deco glifo" style="--x:56%;--y:88%;--t:1.6rem;--p:1.4;--r:-8deg">♞&#xfe0e;</span>
      <span class="aro-fondo" style="--x:84%;--y:40%;--p:0.5"></span>
    </div>
    <div class="contenedor heroe-grid">
      <div class="escena" data-viaje-desde aria-hidden="true">
        <div class="halo"></div>
        <div class="viajero">
          <div class="flotante">
            <div class="moneda">
              <div class="cara"><Caballo tam="100%" /></div>
              {Array.from({ length: 9 }, (_, i) => <div class="canto" style={`--i:${i + 1}`}></div>)}
              <div class="dorso"><Caballo tam="100%" /></div>
            </div>
          </div>
        </div>
        <div class="sombra"></div>
      </div>
      <div class="heroe-texto">
        <p class="antetitulo entra" style="--d:0">Academia de ajedrez</p>
        <h1 class="titulo-club">
          <span class="titulo-pre entra" style="--d:1">Ajedrez Club</span>
          <span class="titulo-nombre entra" style="--d:2">Mokewa</span>
        </h1>
        <p class="heroe-lema entra" style="--d:3"><span>{LEMA}</span></p>
        <p class="heroe-bajada entra" style="--d:4">Aprende, entrena y compite en torneos presenciales todo el año.</p>
        <div class="grupo-botones entra" style="--d:5">
          <BotonContacto cta />
          <a class="boton boton-secundario" href={`${b}/el-club/#historia`}>Nuestros campeones</a>
        </div>
        <!-- Marcador con forma de reloj de ajedrez -->
        <dl class="marcador entra" style="--d:6">
          <div><dt>{redondeo(torneosPresenciales)}</dt><dd>torneos presenciales</dd></div>
          <div><dt>{campeones}</dt><dd>campeones</dd></div>
          <div><dt>+{anios}</dt><dd>años de torneos</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- 2. QUIÉNES SOMOS -->
  <section class="seccion" id="quienes-somos">
    <div class="contenedor"><QuienesSomos /></div>
  </section>

  <!-- 3. ACADEMIA -->
  <section class="seccion seccion-durazno" id="academia">
    <div class="contenedor">
      <div class="encabezado">
        <div>
          <p class="antetitulo">Academia</p>
          <h2>Clases para empezar y para competir</h2>
        </div>
        <a class="ver-mas" href={`${b}/academia/`}>Ver la academia →</a>
      </div>
      <p class="deslizar" aria-hidden="true">Desliza para ver los 3 niveles →</p>
      <div class="carrusel" tabindex="0" aria-label="Niveles de la academia">
        {NIVELES.map((n) => <NivelTarjeta nivel={n} />)}
      </div>
    </div>
  </section>

  <!-- 4. POR QUÉ MOKEWA -->
  <section class="seccion seccion-naranja por-que">
    <div class="contenedor">
      <div class="por-que-grid">
        <div class="por-que-cabeza">
          <p class="antetitulo">Por qué Mokewa</p>
          <h2>Del peón a la corona</h2>
          <p class="por-que-bajada">En ajedrez, el peón que cruza el tablero corona. Así avanza cada alumno en el club.</p>
        </div>
        <div class="pista" data-viaje-hasta aria-hidden="true">
          <svg class="adornos" viewBox="0 0 200 200">
            <circle class="aro aro-1" cx="100" cy="100" r="92"></circle>
            <circle class="aro aro-2" cx="100" cy="100" r="74"></circle>
            <rect class="casilla-deco c1" x="14" y="30" width="12" height="12"></rect>
            <rect class="casilla-deco c2" x="172" y="56" width="9" height="9"></rect>
            <rect class="casilla-deco c3" x="160" y="160" width="12" height="12"></rect>
            <circle class="punto" cx="36" cy="164" r="4"></circle>
            <circle class="punto" cx="182" cy="120" r="3"></circle>
            <circle class="punto" cx="120" cy="10" r="3"></circle>
          </svg>
        </div>
      <ol class="camino">
        <li class="paso">
          <span class="paso-pieza glifo" aria-hidden="true">♙&#xfe0e;</span>
          <div>
            <span class="paso-n">Paso 1</span>
            <h3>Aprende a tu ritmo</h3>
            <p>Desde la primera jugada, sin apuros.</p>
          </div>
        </li>
        <li class="paso">
          <span class="paso-pieza glifo" aria-hidden="true">♘&#xfe0e;</span>
          <div>
            <span class="paso-n">Paso 2</span>
            <h3>Compite de verdad</h3>
            <p>Torneos presenciales todo el año, también con rating FIDE.</p>
          </div>
        </li>
        <li class="paso paso-final">
          <span class="paso-pieza glifo" aria-hidden="true">♛&#xfe0e;</span>
          <div>
            <span class="paso-n">Paso 3</span>
            <h3>Llega al podio</h3>
            <p>{campeones} campeones ya están en la historia del club. <a href={`${b}/el-club/#historia`}>Conócelos</a></p>
          </div>
        </li>
      </ol>
      </div>
      <Equipo sobreNaranja />
    </div>
  </section>

  <!-- 5. CIERRE -->
  <section class="seccion cierre-seccion">
    <div class="contenedor">
      <div class="cierre">
        <span class="jugada" aria-hidden="true">1.e4</span>
        <div class="cierre-texto">
          <h2>La primera jugada: escríbenos</h2>
          <p>Te contamos horarios, niveles y cómo empezar.</p>
          <Dato como="p" etiqueta="Sede" campo="sede" />
          {mapa && <a class="mapa" href={mapa} rel="noopener" target="_blank">Ver en Google Maps</a>}
        </div>
        <BotonContacto cta clase="cierre-boton" />
      </div>
    </div>
  </section>
</Base>

<script>
  // Caballo viajero: del héroe a «Por qué Mokewa», girando con el scroll.
  import { iniciarViaje } from "../lib/viajero.js";
  iniciarViaje();
</script>

<style>
  /* ---------- 1. Héroe ---------- */
  .heroe {
    padding: 28px 0 44px;
    background:
      radial-gradient(circle at 85% 30%, rgb(242 138 30 / 0.28), transparent 45%),
      radial-gradient(circle at 5% 100%, rgb(247 165 74 / 0.25), transparent 40%),
      linear-gradient(180deg, #fff4e8, #fde7d1);
    position: relative;
    overflow: hidden;
  }
  .heroe::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: conic-gradient(rgb(166 75 8 / 0.06) 25%, transparent 0 50%, rgb(166 75 8 / 0.06) 0 75%, transparent 0);
    background-size: 64px 64px;
    mask-image: linear-gradient(90deg, transparent, #000 60%);
    pointer-events: none;
  }
  .heroe > .contenedor {
    position: relative;
  }
  .heroe-grid {
    display: grid;
    gap: 20px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .heroe {
      padding: 72px 0 80px;
    }
    .heroe-grid {
      grid-template-columns: 1.5fr 1fr;
      gap: 48px;
    }
    .escena {
      order: 2;
    }
  }
  .heroe h1 {
    color: var(--tinta);
  }
  .heroe-bajada {
    font-size: 1.12rem;
    color: var(--suave);
    max-width: 52ch;
    margin-bottom: 1.4em;
  }
  /* Marcador: un reloj de ajedrez oscuro con tres esferas */
  .marcador {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 34px 0 0;
    max-width: 480px;
    background: #1a1714;
    border-radius: 16px;
    box-shadow: 0 10px 24px rgb(26 23 20 / 0.22);
  }
  /* Los dos pulsadores del reloj */
  .marcador::before,
  .marcador::after {
    content: "";
    position: absolute;
    top: -9px;
    width: 46px;
    height: 9px;
    border-radius: 6px 6px 0 0;
    background: #f28a1e;
  }
  .marcador::before {
    left: 16%;
  }
  .marcador::after {
    right: 16%;
    background: #5a2a06;
  }
  .marcador div {
    padding: 14px 10px 12px;
    text-align: center;
  }
  .marcador div + div {
    border-left: 1px solid rgb(255 255 255 / 0.12);
  }
  .marcador dt {
    font-family: var(--titulo);
    font-stretch: 72%;
    font-size: clamp(1.9rem, 7vw, 2.6rem);
    font-weight: 900;
    line-height: 1;
    color: #f7a54a;
    font-variant-numeric: tabular-nums;
  }
  .marcador dd {
    margin: 6px 0 0;
    font-size: 0.8rem;
    line-height: 1.25;
    color: #eadfd1;
  }

  /* ---------- Caballo viajero (moneda 3D) ----------
     Nace en el héroe y aterriza en «Por qué Mokewa» (src/lib/viajero.js).
     El balanceo en bucle es suave y de poca amplitud: se ve para todos. */
  .escena {
    position: relative;
    width: min(32vw, 124px);
    aspect-ratio: 1;
    justify-self: center;
  }
  @media (min-width: 900px) {
    .escena {
      width: 280px;
    }
  }
  .halo {
    position: absolute;
    inset: -10%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(242 138 30 / 0.3), rgb(242 138 30 / 0.07) 50%, transparent 68%);
    opacity: var(--salida, 1);
  }
  .sombra {
    position: absolute;
    left: 27%;
    bottom: -6%;
    width: 46%;
    height: 7%;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
    filter: blur(6px);
    animation: sombra 5.5s ease-in-out infinite;
    opacity: var(--salida, 1);
  }
  .viajero {
    position: absolute;
    inset: 0;
  }
  :global(.viajero.en-viaje) {
    position: absolute;
    inset: auto;
    left: 0;
    top: 0;
    z-index: 15;
    pointer-events: none;
    transform-origin: 0 0;
    will-change: transform;
  }
  .flotante {
    width: 100%;
    height: 100%;
    perspective: 900px;
    animation: flotar 5.5s ease-in-out infinite;
  }
  .moneda {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(calc(var(--giro, 0deg) + var(--ry, 0deg))) rotateZ(var(--inclina, 0deg));
  }
  .cara,
  .dorso,
  .canto {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }
  .cara,
  .dorso {
    display: grid;
    place-items: center;
    padding: 12%;
    backface-visibility: hidden;
  }
  .cara {
    background: radial-gradient(circle at 35% 30%, #ffffff, #efe9e1 72%);
    box-shadow: inset 0 0 0 5px #f28a1e, 0 26px 40px rgb(0 0 0 / 0.45);
  }
  .canto {
    background: #d9700f;
    transform: translateZ(calc(var(--i) * -1.6px));
  }
  .dorso {
    background: #141211;
    box-shadow: inset 0 0 0 5px #f28a1e;
    transform: translateZ(-16px) rotateY(180deg);
  }
  .dorso :global(.silueta) {
    fill: #f7941d;
  }
  .dorso :global(.banda),
  .dorso :global(.corona) {
    fill: #fff;
  }
  .dorso :global(.ojo) {
    fill: #141211;
  }
  .cara :global(svg),
  .dorso :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
  .cara :global(.corona) {
    transform-box: view-box;
    transform-origin: 360px 70px;
    animation: corona 5.5s ease-in-out infinite;
  }
  @keyframes flotar {
    0%, 100% { translate: 0 0; rotate: -2deg; }
    50% { translate: 0 -12px; rotate: 1.5deg; }
  }
  @keyframes corona {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(-4deg) translateY(-6px); }
  }
  @keyframes sombra {
    0%, 100% { transform: scaleX(1); opacity: 0.55; }
    50% { transform: scaleX(0.78); opacity: 0.3; }
  }

  /* ---------- «Por qué Mokewa» con la pista de aterrizaje ---------- */
  .por-que-grid {
    display: grid;
    grid-template-columns: 1fr 104px;
    gap: 0 16px;
    align-items: start;
  }
  .por-que-cabeza h2 {
    margin: 0;
  }
  .pista {
    position: relative;
    width: 104px;
    aspect-ratio: 1;
    justify-self: end;
  }
  .por-que-grid .camino {
    grid-column: 1 / -1;
  }
  @media (min-width: 900px) {
    .por-que-grid {
      grid-template-columns: 1.2fr 1fr;
      grid-template-areas: "cabeza pista" "razones pista";
      gap: 0 56px;
    }
    .por-que-cabeza {
      grid-area: cabeza;
    }
    .pista {
      grid-area: pista;
      width: 300px;
      justify-self: center;
      align-self: center;
    }
    .por-que-grid .camino {
      grid-area: razones;
      grid-column: auto;
      grid-template-columns: 1fr;
    }
  }
  .adornos {
    position: absolute;
    inset: -18%;
    width: 136%;
    height: 136%;
    overflow: visible;
  }
  .aro {
    fill: none;
    stroke: rgb(20 18 17 / 0.3);
    stroke-width: 1.2;
    transition: stroke 0.4s;
    transform-origin: 100px 100px;
  }
  .aro-2 {
    stroke: rgb(255 255 255 / 0.6);
    stroke-dasharray: 3 5;
  }
  .casilla-deco {
    fill: none;
    stroke: #fff;
    stroke-width: 1.4;
    transform-box: fill-box;
    transform-origin: center;
    animation: deriva 7s ease-in-out infinite;
  }
  .c2 {
    animation-delay: -2s;
  }
  .c3 {
    animation-delay: -4s;
  }
  .punto {
    fill: #141211;
    opacity: 0.35;
  }
  @keyframes deriva {
    0%, 100% { transform: translateY(0) rotate(45deg); }
    50% { transform: translateY(-6px) rotate(90deg); }
  }
  .pista:global(.aterrizado) .aro-1 {
    stroke: #141211;
    animation: aterriza 0.7s ease-out;
  }
  @keyframes aterriza {
    from { transform: scale(0.8); opacity: 0.2; }
    to { transform: scale(1); opacity: 1; }
  }

  /* ---------- encabezados de sección ---------- */
  .encabezado {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 4px 20px;
    margin-bottom: 20px;
  }
  .encabezado h2 {
    margin: 0;
    max-width: 22ch;
  }
  .ver-mas {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }

  /* ---------- 2. Academia: carrusel en móvil, 3 columnas en escritorio ---------- */
  .deslizar {
    font-size: 0.85rem;
    color: var(--suave);
    margin: -8px 0 10px;
  }
  .carrusel {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 84%;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px 2px 12px;
    scrollbar-width: thin;
  }
  .carrusel > :global(*) {
    scroll-snap-align: start;
  }
  @media (min-width: 820px) {
    .deslizar {
      display: none;
    }
    .carrusel {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      overflow: visible;
    }
  }

  /* ---------- Por qué Mokewa: el camino del peón a la corona ---------- */
  .por-que-bajada {
    margin: 10px 0 0;
    max-width: 44ch;
    color: var(--suave);
    font-size: 1.05rem;
  }
  .camino {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: grid;
    gap: 22px;
  }
  .paso {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 16px;
    align-items: start;
  }
  /* El recorrido: una línea punteada entre pieza y pieza, como el avance del peón */
  .paso:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 27px;
    top: 60px;
    bottom: -20px;
    border-left: 2px dashed rgb(20 18 17 / 0.45);
  }
  .paso-pieza {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #fff;
    color: #141211;
    font-size: 1.9rem;
    box-shadow: 0 6px 16px rgb(90 42 6 / 0.18);
  }
  .paso-final .paso-pieza {
    background: #141211;
    color: #f7a54a;
  }
  .paso-n {
    font-size: 0.74rem;
    font-weight: 700;
    font-stretch: 88%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #3d2412;
  }
  .paso h3 {
    margin: 2px 0 4px;
    font-size: 1.25rem;
  }
  .paso p {
    margin: 0;
    color: var(--suave);
    font-size: 0.98rem;
  }
  .paso a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 650;
  }

  /* ---------- 5. Cierre: una banda oscura con la primera jugada de fondo ---------- */
  .cierre {
    --suave: #d9ccbc;
    --tinta: #fff;
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 18px;
    align-items: center;
    padding: 28px 24px;
    border-radius: 22px;
    color: #fff;
    background:
      conic-gradient(rgb(255 255 255 / 0.035) 25%, transparent 0 50%, rgb(255 255 255 / 0.035) 0 75%, transparent 0) 0 0 / 56px 56px,
      #1a1714;
  }
  @media (min-width: 860px) {
    .cierre {
      grid-template-columns: 1fr auto;
      padding: 44px 48px;
    }
  }
  /* «1.e4»: la jugada de apertura más común, de marca de agua */
  .jugada {
    position: absolute;
    right: -0.06em;
    bottom: -0.28em;
    font-family: var(--titulo);
    font-stretch: 70%;
    font-weight: 900;
    font-size: clamp(7rem, 22vw, 13rem);
    line-height: 1;
    color: rgb(242 138 30 / 0.16);
    pointer-events: none;
    user-select: none;
  }
  .cierre-texto,
  .cierre :global(.cierre-boton) {
    position: relative;
  }
  .cierre h2 {
    margin-bottom: 6px;
    color: #fff;
  }
  .cierre p {
    margin: 0 0 8px;
    color: var(--suave);
  }
  .cierre :global(.cierre-boton) {
    justify-self: start;
    min-height: 54px;
    padding: 0 28px;
    font-size: 1.05rem;
  }
  .cierre .mapa {
    color: #f7a54a;
  }
  .mapa {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }

  /* ---------- Héroe dinámico ----------
     Movimientos suaves y de poca amplitud: se ven para todos (el PC del dueño reporta
     «reducir movimiento» y aun así debe verlos). Nada parpadea ni se mueve bruscamente. */

  /* Título como el logo: «Ajedrez Club» pequeño y «Mokewa» grande */
  .titulo-club {
    display: grid;
    margin: 0 0 0.2em;
    line-height: 0.95;
  }
  .titulo-pre {
    font-size: clamp(1.25rem, 4.2vw, 1.85rem);
    font-weight: 750;
    font-stretch: 92%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta);
  }
  .titulo-nombre {
    font-size: clamp(4.2rem, 19vw, 8.4rem);
    font-weight: 900;
    font-stretch: 70%;
    line-height: 0.86;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    color: #b0500a;
    margin-left: -0.03em; /* alinea ópticamente la M con el texto de arriba */
  }
