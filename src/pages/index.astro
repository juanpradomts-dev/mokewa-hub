---
// Portada: el público principal es el padre de familia. Máximo 5 secciones:
// héroe · academia · por qué Mokewa · orgullo del club · cierre.
import Base from "../layouts/Base.astro";
import Caballo from "../components/Caballo.astro";
import BotonContacto from "../components/BotonContacto.astro";
import NivelTarjeta from "../components/NivelTarjeta.astro";
import Equipo from "../components/Equipo.astro";
import Dato from "../components/Dato.astro";
import club from "../data/club.json";
import { NIVELES } from "../lib/niveles.js";
import { valor } from "../lib/contenido.js";

const b = import.meta.env.BASE_URL.replace(/\/$/, "");
const t = club.totales;
const anioActual = Number(club.actualizado_en.slice(0, 4));
const anios = anioActual - t.desde; // desde el primer torneo online registrado (cota inferior)
const hibridos = club.torneos.filter((x) => x.formato === "Torneos híbridos por nivel").length;
const mapa = valor("mapa");
---

<Base titulo="Inicio" seccion="inicio" descripcion="Academia de ajedrez en Moquegua: clases por niveles, torneos todo el año y una comunidad que compite desde 2020.">
  <!-- 1. HÉROE -->
  <section class="heroe seccion-oscura">
    <div class="contenedor heroe-grid">
      <div class="escena" aria-hidden="true">
        <div class="halo"></div>
        <div class="flotante"><div class="medallon"><Caballo tam="100%" /></div></div>
        <div class="sombra"></div>
      </div>
      <div class="heroe-texto">
        <p class="antetitulo">Academia de ajedrez en Moquegua</p>
        <h1>Que tu hijo gane concentración, disciplina y ganas de competir</h1>
        <p class="heroe-bajada">Clases por niveles y torneos todo el año con el Ajedrez Club Mokewa.</p>
        <div class="grupo-botones">
          <BotonContacto cta />
          <a class="boton boton-claro" href={`${b}/torneos/`}>Ver torneos</a>
        </div>
        <dl class="prueba-social">
          <div><dt>+{anios} años</dt><dd>organizando torneos (desde {t.desde})</dd></div>
          <div><dt>{t.torneos}</dt><dd>torneos organizados en línea</dd></div>
          <div><dt>FIDE</dt><dd><a href="https://ratings.fide.com/report.phtml?event=350802" rel="noopener" target="_blank">torneo oficial con rating</a> en 2024</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- 2. ACADEMIA -->
  <section class="seccion" id="academia">
    <div class="contenedor">
      <div class="encabezado">
        <div>
          <p class="antetitulo">Academia</p>
          <h2>Clases por niveles</h2>
        </div>
        <a class="ver-mas" href={`${b}/academia/`}>Ver la academia →</a>
      </div>
      <p class="deslizar" aria-hidden="true">Desliza para ver los 3 niveles →</p>
      <div class="carrusel" tabindex="0" aria-label="Niveles de la academia">
        {NIVELES.map((n) => <NivelTarjeta nivel={n} />)}
      </div>
    </div>
  </section>

  <!-- 3. POR QUÉ MOKEWA -->
  <section class="seccion seccion-oscura">
    <div class="contenedor">
      <p class="antetitulo">Por qué Mokewa</p>
      <h2>Un club que compite, no solo una clase</h2>
      <ul class="razones">
        <li class="razon">
          <span class="razon-icono glifo" aria-hidden="true">♜&#xfe0e;</span>
          <div>
            <h3>Compite de verdad</h3>
            <p>{t.torneos} torneos desde {t.desde}: semanales de bala y rápidas, temáticos y {hibridos} torneos por nivel.</p>
          </div>
        </li>
        <li class="razon">
          <span class="razon-icono glifo" aria-hidden="true">♚&#xfe0e;</span>
          <div>
            <h3>Torneo oficial FIDE</h3>
            <p>El club organizó el II IRT Clásico Cerrado «Ajedrez Club Mokewa» (2024), válido para rating FIDE.</p>
          </div>
        </li>
        <li class="razon">
          <span class="razon-icono glifo" aria-hidden="true">♞&#xfe0e;</span>
          <div>
            <h3>Comunidad todo el año</h3>
            <p>{club.equipo.miembros} miembros en el equipo de Lichess y batallas contra otros clubes.</p>
          </div>
        </li>
      </ul>
      <Equipo oscuro />
    </div>
  </section>

  <!-- 4. ORGULLO DEL CLUB -->
  <section class="seccion">
    <div class="contenedor">
      <div class="encabezado">
        <div>
          <p class="antetitulo">Orgullo del club</p>
          <h2>{t.campeones} campeones desde {t.desde}</h2>
        </div>
        <a class="ver-mas" href={`${b}/el-club/#salon`}>Ver el Salón de la Fama →</a>
      </div>
      <ol class="podio">
        {club.destacados.map((c, i) => (
          <li class="tarjeta campeon">
            <span class="puesto" aria-label={`Puesto ${i + 1}`}>{i + 1}</span>
            <div>
              <a href={`${b}/jugador/?u=${encodeURIComponent(c.u)}`}><strong>{c.u}</strong></a>
              <span>{c.titulos} títulos · {c.podios} podios · {c.torneos} torneos</span>
            </div>
          </li>
        ))}
      </ol>
      <form class="buscador tarjeta" action={`${b}/el-club/`} method="get" role="search">
        <label for="q-inicio">¿Estás en el Salón? Busca tu usuario de Lichess</label>
        <div class="fila">
          <input id="q-inicio" name="q" type="search" placeholder="Tu usuario" autocomplete="off" spellcheck="false" />
          <button class="boton boton-secundario" type="submit">Buscar</button>
        </div>
      </form>
    </div>
  </section>

  <!-- 5. CIERRE -->
  <section class="seccion cierre-seccion">
    <div class="contenedor">
      <div class="cierre tarjeta">
        <div>
          <h2>La primera jugada: escríbenos</h2>
          <p>Te contamos horarios, niveles y cómo empezar.</p>
          <Dato como="p" etiqueta="Sede" campo="sede" />
          {mapa && <a class="mapa" href={mapa} rel="noopener" target="_blank">Ver en Google Maps</a>}
        </div>
        <BotonContacto cta />
      </div>
    </div>
  </section>
</Base>

<script>
  // Al enviar el buscador, ir directo a la sección del Salón.
  document.querySelector<HTMLFormElement>(".buscador")?.addEventListener("submit", (e) => {
    const f = e.currentTarget as HTMLFormElement;
    const q = (f.querySelector("input") as HTMLInputElement).value.trim();
    e.preventDefault();
    location.href = `${f.action}${q ? `?q=${encodeURIComponent(q)}` : ""}#salon`;
  });

  // El caballo se inclina un poco hacia el cursor (responde al usuario, no se mueve solo).
  const heroe = document.querySelector<HTMLElement>(".heroe");
  const caballo = document.querySelector<HTMLElement>(".flotante");
  if (heroe && caballo && matchMedia("(pointer: fine)").matches) {
    heroe.addEventListener("pointermove", (e) => {
      const r = heroe.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      caballo.style.setProperty("--px", `${(x * 14).toFixed(1)}px`);
      caballo.style.setProperty("--py", `${(y * 10).toFixed(1)}px`);
      caballo.style.setProperty("--ry", `${(x * 16).toFixed(1)}deg`);
    });
    heroe.addEventListener("pointerleave", () => {
      for (const v of ["--px", "--py", "--ry"]) caballo.style.removeProperty(v);
    });
  }
</script>

<style>
  /* ---------- 1. Héroe ---------- */
  .heroe {
    padding: 28px 0 44px;
  }
  .heroe-grid {
    display: grid;
    gap: 20px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .heroe {
      padding: 72px 0 80px;
    }
    .heroe-grid {
      grid-template-columns: 1.5fr 1fr;
      gap: 48px;
    }
    .escena {
      order: 2;
    }
  }
  .heroe h1 {
    color: #fff;
    font-size: clamp(2rem, 6.2vw, 3.3rem);
  }
  .heroe .antetitulo {
    color: #c9c0b5;
  }
  .heroe-bajada {
    font-size: 1.12rem;
    color: #ddd5cb;
    max-width: 52ch;
    margin-bottom: 1.4em;
  }
  .boton-claro {
    background: transparent;
    color: #fff;
    border-color: rgb(255 255 255 / 0.4);
  }
  .boton-claro:hover {
    color: #fff;
    border-color: #fff;
  }
  .prueba-social {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 32px 0 0;
    padding-top: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    max-width: 560px;
  }
  .prueba-social dt {
    font-family: var(--serif);
    font-size: clamp(1.45rem, 5vw, 2rem);
    font-weight: 650;
    color: #fff;
    line-height: 1.1;
  }
  .prueba-social dd {
    margin: 4px 0 0;
    font-size: 0.84rem;
    color: #c9c0b5;
    line-height: 1.35;
  }
  .prueba-social a {
    color: #f3eee8;
  }

  /* caballo flotante (se anima para todos: es suave y de poca amplitud) */
  .escena {
    position: relative;
    width: min(32vw, 124px);
    aspect-ratio: 1;
    justify-self: center;
    display: grid;
    place-items: center;
    perspective: 600px;
  }
  @media (min-width: 900px) {
    .escena {
      width: 280px;
    }
  }
  .halo {
    position: absolute;
    inset: -8%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(242 138 30 / 0.3), rgb(242 138 30 / 0.07) 50%, transparent 68%);
  }
  .flotante {
    position: relative;
    width: 78%;
    animation: flotar 5.5s ease-in-out infinite;
    transform: translate(var(--px, 0px), var(--py, 0px)) rotateY(var(--ry, 0deg));
    transition: transform 0.25s ease-out;
  }
  .medallon {
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ffffff, #f1ece5 70%);
    box-shadow: 0 0 0 5px rgb(242 138 30 / 0.9), 0 0 0 12px rgb(242 138 30 / 0.16), 0 24px 40px rgb(0 0 0 / 0.5);
    display: grid;
    place-items: center;
    padding: 10%;
  }
  .flotante :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .flotante :global(.corona) {
    transform-origin: 119px 48px;
    animation: corona 5.5s ease-in-out infinite;
  }
  .sombra {
    position: absolute;
    bottom: -4%;
    width: 46%;
    height: 7%;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
    filter: blur(6px);
    animation: sombra 5.5s ease-in-out infinite;
  }
  @keyframes flotar {
    0%, 100% { translate: 0 0; rotate: -2deg; }
    50% { translate: 0 -14px; rotate: 1.5deg; }
  }
  @keyframes corona {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(-4deg) translateY(-2px); }
  }
  @keyframes sombra {
    0%, 100% { transform: scaleX(1); opacity: 0.55; }
    50% { transform: scaleX(0.78); opacity: 0.3; }
  }

  /* ---------- encabezados de sección ---------- */
  .encabezado {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 4px 20px;
    margin-bottom: 20px;
  }
  .encabezado h2 {
    margin: 0;
    max-width: 22ch;
  }
  .ver-mas {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }

  /* ---------- 2. Academia: carrusel en móvil, 3 columnas en escritorio ---------- */
  .deslizar {
    font-size: 0.85rem;
    color: var(--suave);
    margin: -8px 0 10px;
  }
  .carrusel {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 84%;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px 2px 12px;
    scrollbar-width: thin;
  }
  .carrusel > :global(*) {
    scroll-snap-align: start;
  }
  @media (min-width: 820px) {
    .deslizar {
      display: none;
    }
    .carrusel {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      overflow: visible;
    }
  }

  /* ---------- 3. Por qué Mokewa ---------- */
  .razones {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  @media (min-width: 860px) {
    .razones {
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }
  }
  .razon {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 14px;
    align-items: start;
  }
  .razon h3 {
    margin: 4px 0 4px;
    font-size: 1.15rem;
  }
  .razon p {
    margin: 0;
    color: var(--suave);
    font-size: 0.97rem;
  }
  .razon-icono {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.08);
    color: #fff;
    font-size: 1.8rem;
  }

  /* ---------- 4. Orgullo del club ---------- */
  .podio {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  @media (min-width: 820px) {
    .podio {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .campeon {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 16px 18px;
  }
  .campeon div {
    display: grid;
    min-width: 0;
  }
  .campeon a {
    color: var(--tinta);
    text-decoration: none;
    overflow-wrap: anywhere;
    font-size: 1.08rem;
  }
  .campeon a:hover {
    color: var(--vino);
    text-decoration: underline;
  }
  .campeon span:not(.puesto) {
    font-size: 0.88rem;
    color: var(--suave);
  }
  .puesto {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    background: var(--casilla);
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.2rem;
  }
  .campeon:first-child .puesto {
    background: #141211;
    color: #fff;
  }
  .buscador label {
    font-weight: 650;
    display: block;
    margin-bottom: 8px;
  }
  .fila {
    display: flex;
    gap: 8px;
  }
  .fila input {
    min-width: 0;
  }

  /* ---------- 5. Cierre ---------- */
  .cierre {
    display: grid;
    gap: 16px;
    align-items: center;
    padding: 22px;
    border-top: 4px solid var(--oro);
  }
  @media (min-width: 860px) {
    .cierre {
      grid-template-columns: 1fr auto;
      padding: 36px 40px;
    }
  }
  .cierre h2 {
    margin-bottom: 6px;
  }
  .cierre p {
    margin: 0 0 8px;
    color: var(--suave);
  }
  .mapa {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }
</style>
