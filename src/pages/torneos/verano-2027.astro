---
import Dato from "../../components/Dato.astro";
import Base from "../../layouts/Base.astro";
import { esProduccion } from "../../lib/contenido.js";
const b = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base titulo="Torneo de Verano 2027" seccion="torneos" descripcion="Inscripción en línea al Torneo de Verano 2027 del Ajedrez Club Mokewa (ejemplo de la demo).">
  <section class="seccion">
    <div class="contenedor">
      <p class="migas"><a href={`${b}/torneos/`}>Torneos</a> / <span id="t-miga">Torneo de Verano 2027</span></p>
      <div class="torneo-etiquetas" id="t-etiquetas"><span class="etiqueta etiqueta-ejemplo">Ejemplo para la demo</span><span class="etiqueta">Presencial</span></div>
      <h1 id="t-nombre">Torneo de Verano 2027</h1>
      <p class="bajada" id="t-bajada">
        Este torneo es un <strong>ejemplo</strong> para mostrar cómo funciona la inscripción en línea. Las bases, fecha y costo reales los define el club.
      </p>
      <div class="rejilla rejilla-4 ficha-datos" id="t-datos">
        <Dato como="div" clase="tarjeta" etiqueta="Fecha" campo="verano_fecha" />
        <Dato como="div" clase="tarjeta" etiqueta="Ritmo de juego" campo="verano_ritmo" />
        <Dato como="div" clase="tarjeta" etiqueta="Inscripción" campo="verano_costo" />
        <Dato como="div" clase="tarjeta" etiqueta="Cupo" campo="verano_cupo" />
      </div>
      <p class="cat">Categorías: <span id="t-cats-lista">Sub-8, Sub-10, Sub-12, Sub-14, Sub-16, Sub-18 y Libre</span>. La categoría se calcula sola con la fecha de nacimiento (edad al 1 de enero del año del torneo).</p>
      <Dato como="p" etiqueta="Sede" campo="sede" />
    </div>
  </section>

  <section class="seccion" id="inscripcion">
    <div class="contenedor inscripcion-grid">
      <div>
        <div id="confirmacion" hidden></div>
        <form class="tarjeta formulario" id="formulario" novalidate>
          <h2>Inscripción en línea</h2>
          <p class="ayuda-form">Toma menos de 2 minutos. Los campos con * son obligatorios.</p>

          <fieldset>
            <legend>1. Jugador</legend>
            <div class="dos-columnas">
              <div class="campo">
                <label for="nombres">Nombres *</label>
                <input id="nombres" name="nombres" type="text" autocomplete="given-name" required />
              </div>
              <div class="campo">
                <label for="apellidos">Apellidos *</label>
                <input id="apellidos" name="apellidos" type="text" autocomplete="family-name" required />
              </div>
              <div class="campo">
                <label for="fecha_nacimiento">Fecha de nacimiento *</label>
                <input id="fecha_nacimiento" name="fecha_nacimiento" type="date" required min="1920-01-01" />
                <span class="categoria-calculada" id="categoria" aria-live="polite"></span>
              </div>
              <div class="campo">
                <label for="nivel">Nivel *</label>
                <select id="nivel" name="nivel" required>
                  <option value="">Elige un nivel</option>
                  <option>Básico</option>
                  <option>Intermedio</option>
                  <option>Avanzado</option>
                </select>
              </div>
              <div class="campo">
                <label for="club">Club o colegio</label>
                <input id="club" name="club" type="text" placeholder="Ej.: Ajedrez Club Mokewa" />
              </div>
              <div class="campo">
                <label for="lichess">Usuario de Lichess</label>
                <input id="lichess" name="lichess" type="text" autocomplete="off" spellcheck="false" />
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend id="contacto-titulo">2. Contacto</legend>
            <p class="ayuda" id="aviso-menor" hidden>El jugador es menor de edad: los datos de contacto son del padre, madre o tutor.</p>
            <div class="dos-columnas">
              <div class="campo" id="campo-tutor">
                <label for="tutor_nombre">Nombre del padre, madre o tutor *</label>
                <input id="tutor_nombre" name="tutor_nombre" type="text" autocomplete="name" />
              </div>
              <div class="campo">
                <label for="tutor_telefono">Celular (WhatsApp) *</label>
                <input id="tutor_telefono" name="tutor_telefono" type="tel" inputmode="numeric" autocomplete="tel" placeholder="9 dígitos" />
              </div>
              <div class="campo">
                <label for="tutor_correo">Correo *</label>
                <input id="tutor_correo" name="tutor_correo" type="email" autocomplete="email" />
                <span class="ayuda">Aquí llega la confirmación de la inscripción.</span>
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>3. Pago</legend>
            <div class="pago">
              <p>Paga con <strong>Yape o Plin</strong> y sube el comprobante aquí abajo.</p>
              <div class="pago-datos"><Dato etiqueta="Número" campo="yape" /><Dato etiqueta="Monto" campo="verano_costo" /></div>
              <p class="ayuda">Luego sube una foto o captura del comprobante. El organizador lo valida y verás el estado: pendiente, validado o rechazado.</p>
            </div>
            <div class="campo">
              <label for="voucher">Comprobante de pago (JPG, PNG o PDF, máx. 5 MB) *</label>
              <input id="voucher" name="voucher" type="file" accept="image/jpeg,image/png,application/pdf" />
              <span class="ayuda" id="voucher-info"></span>
            </div>
          </fieldset>

          <fieldset>
            <legend>4. Autorización</legend>
            <label class="casilla">
              <input type="checkbox" id="consentimiento" name="consentimiento" />
              <span>
                Autorizo al Ajedrez Club Mokewa a usar estos datos solo para gestionar esta inscripción, conforme a la Ley N.º 29733 de Protección de Datos Personales. Si el jugador es menor de edad, declaro ser su padre, madre o tutor. En la lista pública solo aparecerán su nombre, categoría y club. <a href={`${b}/privacidad/`} target="_blank">Ver política de privacidad</a> *
              </span>
            </label>
          </fieldset>

          <div class="alerta alerta-error" id="errores" hidden role="alert"></div>
          <button class="boton boton-primario enviar" type="submit">Enviar inscripción</button>
          <p class="ayuda demo-nota">Demo: los datos se guardan solo en este navegador. Puedes usar datos inventados.</p>
        </form>
      </div>

      <aside>
        <div class="tarjeta" id="inscritos">
          <h2 class="h-lateral">Inscritos <span class="num" id="n-inscritos"></span></h2>
          <p class="ayuda">Lista pública: solo nombre, categoría y club.{!esProduccion && " Los nombres de esta demo son de ejemplo."}</p>
          <div id="lista-inscritos"></div>
        </div>
        <div class="tarjeta mis" id="mis-inscripciones" hidden>
          <h2 class="h-lateral">Mis inscripciones</h2>
          <ul id="lista-mias"></ul>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script src="../../lib/inscripcion.js"></script>

<style>
  .migas {
    font-size: 0.9rem;
    color: var(--suave);
  }
  .torneo-etiquetas {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .ficha-datos {
    margin: 20px 0 12px;
  }
  :global(#t-datos .tarjeta) {
    display: grid;
    gap: 4px;
    justify-items: start;
    padding: 14px 16px;
  }
  :global(.dt) {
    font-size: 0.8rem;
    color: var(--suave);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .cat {
    font-size: 0.93rem;
    color: var(--suave);
  }
  .inscripcion-grid {
    display: grid;
    gap: 20px;
  }
  .inscripcion-grid > * {
    min-width: 0; /* que el formulario no ensanche la página en celulares chicos */
  }
  @media (min-width: 980px) {
    .inscripcion-grid {
      grid-template-columns: 1.6fr 1fr;
      align-items: start;
    }
    aside {
      position: sticky;
      top: 84px;
    }
  }
  .formulario {
    padding: 24px;
  }
  .ayuda-form {
    color: var(--suave);
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 12px;
    min-width: 0;
  }
  legend {
    font-family: var(--titulo);
    font-stretch: var(--angosto);
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 12px;
    padding: 0;
  }
  .ayuda,
  :global(#confirmacion .ayuda) {
    font-size: 0.86rem;
    color: var(--suave);
  }
  .categoria-calculada {
    font-size: 0.95rem;
    color: var(--ok);
    min-height: 1.4em;
  }
  .pago {
    background: var(--casilla);
    border-radius: 10px;
    padding: 14px 16px;
    margin-bottom: 14px;
  }
  .pago p {
    margin: 0 0 6px;
  }
  input[type="file"] {
    font: inherit;
    font-size: 0.95rem;
    padding: 10px;
    border: 1.5px dashed var(--linea);
    border-radius: 10px;
    background: var(--papel);
    width: 100%;
    color: var(--tinta);
  }
  .enviar {
    width: 100%;
    margin-top: 12px;
  }
  .demo-nota {
    text-align: center;
    margin: 10px 0 0;
  }
  #errores {
    margin-top: 8px;
  }
  .h-lateral {
    font-size: 1.3rem;
  }
  aside .tarjeta + .tarjeta {
    margin-top: 16px;
  }
  .mis ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  :global(#lista-inscritos td:nth-child(2)) {
    white-space: nowrap;
  }
  :global(.ok) {
    color: var(--ok);
    font-weight: 700;
  }
  :global(.exito) {
    border-left: 5px solid var(--ok);
  }
  :global(.tiempo) {
    font-weight: 650;
    color: var(--ok);
  }
  .pago-datos {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin: 4px 0 10px;
  }
</style>
