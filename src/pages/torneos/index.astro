---
// Torneos: solo presenciales, cada uno con su foto (o la ilustración del club mientras no haya foto).
// Los torneos online viven en El Club › Comunidad.
import Base from "../../layouts/Base.astro";
import Dato from "../../components/Dato.astro";
import FotoTorneo from "../../components/FotoTorneo.astro";
import presenciales from "../../data/torneos-presenciales.json";
import BotonContacto from "../../components/BotonContacto.astro";
import { valor, esProduccion } from "../../lib/contenido.js";
import { hayBaseDeDatos } from "../../lib/backend.js";
const enLinea = !esProduccion || hayBaseDeDatos;

const b = import.meta.env.BASE_URL.replace(/\/$/, "");
// El Torneo de Verano 2027 es un ejemplo hasta que el club confirma su fecha. En producción, sin fecha, no se publica.
const veranoReal = !!valor("verano_fecha");
const mostrarVerano = veranoReal || !esProduccion;
const realizados = [...presenciales.torneos].sort((a, c) => c.fecha.localeCompare(a.fecha));
---

<Base titulo="Torneos" seccion="torneos" descripcion="Torneos presenciales del Ajedrez Club Mokewa en Moquegua: inscripción en línea, fotos y resultados.">
  <section class="seccion cabeza">
    <div class="contenedor">
      <p class="antetitulo">Torneos presenciales</p>
      <h1>Torneos del club</h1>
      <p class="bajada">{enLinea ? "Inscríbete en línea a los próximos torneos y revive los que ya jugamos." : "Los próximos torneos del club y los que ya jugamos."}</p>
    </div>
  </section>

  <section class="seccion proximos-seccion">
    <div class="contenedor">
      <h2 class="h-seccion">Próximos</h2>
      {!mostrarVerano && (
        <div class="tarjeta sin-proximos" id="sin-proximos">
          <p>El próximo torneo se anuncia aquí y en la página de Facebook del club.</p>
          <BotonContacto variante="secundario" accion="Preguntar por torneos" mensaje="Hola, quisiera saber cuándo es el próximo torneo del club." />
        </div>
      )}
      <div class="rejilla rejilla-2" id="proximos">
        {mostrarVerano && (
        <article class="tarjeta torneo">
          <FotoTorneo alt="Torneo de Verano 2027" tono="naranja" />
          <div class="torneo-cuerpo">
            <div class="etiquetas">{!veranoReal && <span class="etiqueta etiqueta-ejemplo" data-sin-campo="verano_fecha">Ejemplo para la demo</span>}<span class="etiqueta">Presencial</span></div>
            <h3><a href={`${b}/torneos/verano-2027/`}>Torneo de Verano 2027</a></h3>
            <div class="datos">
              <Dato como="div" etiqueta="Fecha" campo="verano_fecha" />
              <Dato como="div" etiqueta="Ritmo" campo="verano_ritmo" />
              <Dato como="div" etiqueta="Inscripción" campo="verano_costo" />
              <Dato como="div" etiqueta="Sede" campo="sede" />
            </div>
            <p class="cat">Categorías Sub-8 a Sub-18 y Libre · niveles básico, intermedio y avanzado</p>
            <div class="grupo-botones">
              <a class="boton boton-primario" href={`${b}/torneos/verano-2027/#inscripcion`}>Inscribirme</a>
              <a class="boton boton-secundario" href={`${b}/torneos/verano-2027/#inscritos`}>Ver inscritos</a>
            </div>
          </div>
        </article>
        )}
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <h2 class="h-seccion">Torneos realizados</h2>
      <div class="rejilla rejilla-3">
        {realizados.map((x) => (
          <article class="tarjeta torneo">
            <FotoTorneo foto={x.foto} alt={x.nombre} />
            <div class="torneo-cuerpo">
              <div class="etiquetas"><span class="etiqueta etiqueta-vino">{x.tipo}</span></div>
              <h3>{x.nombre}</h3>
              <p class="cat">{x.fecha.slice(0, 4)}</p>
              {x.resumen && <p>{x.resumen}</p>}
              {x.fuente && <a class="fuente" href={x.fuente} rel="noopener" target="_blank">{x.fuente_texto ?? "Fuente"}</a>}
            </div>
          </article>
        ))}
      </div>
      <p class="nota nota-torneos">
        Los campeones de cada torneo del club están en <a href={`${b}/el-club/#historia`}>Nuestra historia</a>. ¿Buscas los torneos en línea? Están en <a href={`${b}/el-club/#comunidad`}>El Club · Comunidad</a>.
      </p>
    </div>
  </section>

  <section class="seccion" id="resultados-panel" hidden>
    <div class="contenedor">
      <h2 class="h-seccion">Resultados publicados por el club</h2>
      <div id="resultados-lista" class="rejilla rejilla-2"></div>
    </div>
  </section>
</Base>

<script>
  import { esc } from "../../lib/html.js";
  import { todosLosTorneos, resultadosPublicados, alCambiar, listaPublica } from "../../lib/store.js";

  const base = document.body.dataset.base ?? "";
  const fotoHtml = (url: string | undefined, alt: string) =>
    url && /^https:\/\//.test(url)
      ? `<figure class="foto-panel"><img src="${esc(url)}" alt="${esc(alt)}" loading="lazy" /></figure>`
      : "";

  // Torneos presenciales creados desde el panel (demo) y resultados publicados.
  const proximos = document.getElementById("proximos")!;
  function pintarPanel() {
    proximos.querySelectorAll("[data-del-panel]").forEach((n) => n.remove());
    for (const t of todosLosTorneos().filter((t: any) => !t.ejemplo && t.modalidad !== "Online")) {
      const n = listaPublica(t.id).length;
      const art = document.createElement("article");
      art.className = "tarjeta torneo";
      art.dataset.delPanel = "1";
      art.innerHTML = `${fotoHtml(t.foto, t.nombre)}<div class="torneo-cuerpo"><div class="etiquetas"><span class="etiqueta etiqueta-ok">Nuevo</span><span class="etiqueta">${esc(t.modalidad)}</span></div>
        <h3><a href="${base}/torneos/torneo/?t=${encodeURIComponent(t.id)}">${esc(t.nombre)}</a></h3>
        <p class="cat">${esc(t.fecha || "Fecha por anunciar")}${t.sede ? " · " + esc(t.sede) : ""}${t.ritmo ? " · " + esc(t.ritmo) : ""}</p>
        <p class="cat">${esc((t.categorias || []).join(", "))}${t.cupo ? ` · cupo ${esc(t.cupo)}` : ""}${t.costo ? ` · ${esc(t.costo)}` : ""} · ${n} ${n === 1 ? "inscrito" : "inscritos"}</p>
        <div class="grupo-botones"><a class="boton boton-primario" href="${base}/torneos/torneo/?t=${encodeURIComponent(t.id)}#inscripcion">Inscribirme</a></div></div>`;
      proximos.append(art);
    }

    const res = resultadosPublicados();
    const claves = Object.keys(res);
    document.getElementById("resultados-panel")!.hidden = !claves.length;
    document.getElementById("resultados-lista")!.innerHTML = claves
      .map((k) => {
        const r = res[k];
        const filas = r.filas
          .slice(0, 10)
          .map((f: any) => `<tr><td class="num">${f.puesto}</td><td>${esc(f.nombre)}</td><td>${esc(f.categoria || "")}</td><td class="num">${f.puntos ?? "—"}</td></tr>`)
          .join("");
        return `<article class="tarjeta"><div class="etiquetas"><span class="etiqueta etiqueta-ok">Publicado por el club</span><span class="etiqueta">${esc(r.origen)}</span></div>
          <h3>${esc(r.nombre)}</h3>
          <div class="tabla-envoltura"><table><thead><tr><th class="num">Pto.</th><th>Jugador</th><th>Cat.</th><th class="num">Pts.</th></tr></thead><tbody>${filas}</tbody></table></div>
          ${r.filas.length > 10 ? `<p class="cat">y ${r.filas.length - 10} más</p>` : ""}${r.cronica ? `<p>${esc(r.cronica)}</p>` : ""}</article>`;
      })
      .join("");
  }
  pintarPanel();
  alCambiar(pintarPanel);
</script>

<style>
  .cabeza {
    background: linear-gradient(180deg, #fde7d1, var(--fondo));
    padding-bottom: 24px;
  }
  .h-seccion {
    font-size: clamp(1.4rem, 4vw, 1.9rem);
  }
  :global(.torneo) {
    display: grid;
    gap: 0;
    padding: 0;
    overflow: hidden;
    align-content: start;
  }
  :global(.torneo .foto-torneo),
  :global(.torneo .foto-panel) {
    border-radius: 0;
    margin: 0;
  }
  :global(.foto-panel) {
    aspect-ratio: 4 / 3;
  }
  :global(.foto-panel img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  :global(.torneo-cuerpo) {
    display: grid;
    gap: 8px;
    padding: 20px 22px 22px;
  }
  :global(.torneo h3) {
    font-size: 1.3rem;
    margin: 2px 0 0;
  }
  :global(.torneo h3 a) {
    color: var(--tinta);
    text-decoration: none;
  }
  :global(.torneo h3 a:hover) {
    color: var(--vino);
  }
  :global(.torneo p) {
    margin: 0;
  }
  :global(.etiquetas) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  :global(.cat) {
    font-size: 0.92rem;
    color: var(--suave);
  }
  .datos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin: 4px 0;
  }
  .fuente {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }
  .nota-torneos {
    margin-top: 20px;
  }
  /* Un solo torneo en la lista: tarjeta horizontal a todo el ancho (foto a la izquierda),
     en vez de una tarjeta angosta con un hueco al lado. */
  @media (min-width: 760px) {
    :global(.rejilla:has(> .torneo:only-child)) {
      grid-template-columns: 1fr;
    }
    :global(.rejilla > .torneo:only-child) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: stretch;
    }
    :global(.rejilla > .torneo:only-child .foto-torneo),
    :global(.rejilla > .torneo:only-child .foto-panel) {
      aspect-ratio: auto;
      min-height: 100%;
    }
    :global(.rejilla > .torneo:only-child .torneo-cuerpo) {
      align-content: center;
      padding: 28px 32px;
    }
  }
  .sin-proximos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
  }
  .sin-proximos p {
    margin: 0;
  }
</style>
