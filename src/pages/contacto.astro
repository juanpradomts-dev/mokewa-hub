---
// Contacto: dos accesos claros. Escribir (el Gmail del club es el canal principal; mientras falte,
// WhatsApp o Facebook) y llegar: el mapa de Google Maps incrustado, conectado a la ficha del club, y
// «Cómo llegar» con la ruta. Lo demás va en pequeño.
import Dato from "../components/Dato.astro";
import Base from "../layouts/Base.astro";
import BotonContacto from "../components/BotonContacto.astro";
import Redes from "../components/Redes.astro";
import { valor, esProduccion } from "../lib/contenido.js";
import { enlaceContacto } from "../lib/contacto.js";
import { lugarDelMapa, mapaIncrustado, comoLlegar } from "../lib/mapa.js";

// Los textos dicen por dónde responde el club de verdad: Gmail, WhatsApp o, mientras falten, Facebook.
const POR = { correo: "por correo", whatsapp: "por WhatsApp", facebook: "por mensaje en Facebook" };
const TITULO = { correo: "Correo", whatsapp: "WhatsApp", facebook: "Mensaje directo" };
const canal = enlaceContacto({ correo: valor("correo"), whatsapp: valor("whatsapp") }).tipo;
const lugar = lugarDelMapa(valor("mapa"), valor("sede"));
const conSede = !!lugar || !esProduccion;
---

<Base titulo="Contacto" seccion="contacto" descripcion="Contacto del Ajedrez Club Mokewa en Moquegua: correo, dirección de la sede y cómo llegar.">
  <section class="seccion cabeza">
    <div class="contenedor">
      <div class="principal">
        <p class="antetitulo">Contacto</p>
        <h1>Hablemos</h1>
        <p class="bajada">Pregúntanos por horarios, precios o cómo empezar.</p>

        <div class:list={["accesos", { solo: !conSede }]}>
          <article class="acceso">
            <span class="portada portada-correo" aria-hidden="true">
              <span class="acceso-ico">
                <svg viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M3 5.5h18v13H3z M3.5 6l8.5 7 8.5-7"></path></svg>
              </span>
            </span>
            <h2 data-titulo-canal>{TITULO[canal]}</h2>
            <Dato como="p" clase="acceso-dato" etiqueta="Gmail del club" campo="correo" />
            <p class="acceso-nota">Te respondemos <span data-por>{POR[canal]}</span>.</p>
            <BotonContacto variante="primario" clase="acceso-boton" mensaje="Hola, quisiera información sobre las clases de ajedrez." />
          </article>

          {conSede && (
            <article class="acceso">
              <div class="portada portada-mapa" data-mapa-vivo hidden={!lugar}>
                <iframe
                  src={lugar ? mapaIncrustado(lugar) : undefined}
                  title="Mapa de Google Maps con la sede del Ajedrez Club Mokewa"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen></iframe>
              </div>
              <h2>Dónde estamos</h2>
              <Dato como="p" clase="acceso-dato" etiqueta="Sede del club" campo="sede" />
              <a class="boton boton-secundario acceso-boton" id="mapa" hidden={!lugar} href={lugar ? comoLlegar(lugar) : "#"} rel="noopener" target="_blank">
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"></path></svg>
                Cómo llegar
              </a>
            </article>
          )}
        </div>

        <p class="temas">
          ¿Otra consulta?
          <BotonContacto variante="texto" accion="Torneos" mensaje="Hola, tengo una consulta sobre un torneo del club." />
          <BotonContacto variante="texto" accion="Colegios y empresas" mensaje="Hola, escribo de un colegio o empresa y quisiera información sobre talleres, torneos o patrocinio." />
        </p>
      </div>

      <div class="otros" data-otros>
        <p class="otros-titulo">También estamos en</p>
        <Redes variante="contacto" ocultar={canal} />
        <Dato como="p" clase="atencion" etiqueta="Horario de atención" campo="atencion" />
      </div>
    </div>
  </section>
</Base>

<script>
  import { contenido, alCambiar } from "../lib/store.js";
  import { enlaceContacto } from "../lib/contacto.js";
  import { lugarDelMapa, mapaIncrustado, comoLlegar } from "../lib/mapa.js";
  const POR: Record<string, string> = { correo: "por correo", whatsapp: "por WhatsApp", facebook: "por mensaje en Facebook" };
  const TITULO: Record<string, string> = { correo: "Correo", whatsapp: "WhatsApp", facebook: "Mensaje directo" };
  const mapa = document.getElementById("mapa") as HTMLAnchorElement | null;
  const vivo = document.querySelector<HTMLElement>("[data-mapa-vivo]");
  const marco = vivo?.querySelector("iframe");
  const pintar = () => {
    // El canal principal no se repite en la lista pequeña.
    const { tipo } = enlaceContacto({ correo: contenido("correo"), whatsapp: contenido("whatsapp") });
    document.querySelector("[data-por]")!.textContent = POR[tipo];
    document.querySelector("[data-titulo-canal]")!.textContent = TITULO[tipo];
    for (const li of document.querySelectorAll<HTMLElement>("[data-otros] [data-canal]")) li.hidden = li.dataset.canal === tipo;
    // El mapa y la ruta siguen al enlace de Google Maps (o a la dirección) que cargue el club
    if (!mapa || !vivo || !marco) return;
    const lugar = lugarDelMapa(contenido("mapa"), contenido("sede"));
    if (lugar) {
      mapa.href = comoLlegar(lugar);
      const src = mapaIncrustado(lugar);
      if (marco.getAttribute("src") !== src) marco.setAttribute("src", src);
    }
    mapa.hidden = vivo.hidden = !lugar;
  };
  pintar();
  alCambiar(pintar);
</script>

<style>
  .cabeza {
    background: linear-gradient(180deg, #fde7d1, var(--fondo) 70%);
  }
  .principal {
    position: relative;
    max-width: 820px;
    margin: 8px auto 0;
    padding: clamp(28px, 6vw, 48px) clamp(16px, 5vw, 44px);
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: 22px;
    box-shadow: var(--sombra);
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 6px;
    overflow: hidden;
  }
  /* Borde superior de tablero */
  .principal::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 10px;
    background: conic-gradient(#f28a1e 25%, #1a1714 0 50%, #f28a1e 0 75%, #1a1714 0) 0 0 / 20px 20px;
  }
  .principal :global(.antetitulo) {
    justify-content: center;
    margin-top: 6px;
  }
  .principal h1 {
    margin: 0;
  }
  .principal .bajada {
    margin: 0 auto 14px;
    max-width: 46ch;
  }

  /* Los dos accesos: escribir y llegar */
  .accesos {
    width: 100%;
    display: grid;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .accesos {
      grid-template-columns: 1fr 1fr;
    }
    .accesos.solo {
      grid-template-columns: minmax(0, 380px);
      justify-content: center;
    }
  }
  .acceso {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 22px 18px 20px;
    border-radius: 18px;
    background: #fffaf4;
    border: 1px solid var(--linea);
    transition:
      transform 0.25s,
      box-shadow 0.25s;
  }
  .acceso:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 28px rgb(90 42 6 / 0.12);
  }
  .acceso h2 {
    margin: 2px 0 0;
    font-size: 1.35rem;
  }
  /* Cabecera visual de cada tarjeta: el sobre y el mapa real, a la misma altura */
  .portada {
    display: grid;
    place-items: center;
    width: 100%;
    height: 210px;
    margin-bottom: 4px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--linea);
  }
  .portada[hidden] {
    display: none;
  }
  .portada-correo {
    background:
      conic-gradient(rgb(166 75 8 / 0.06) 25%, transparent 0 50%, rgb(166 75 8 / 0.06) 0 75%, transparent 0) 0 0 / 36px 36px,
      #fff4e8;
  }
  .portada-mapa {
    background: #f1ece4;
  }
  .portada-mapa iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .acceso-ico {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: #fde7d1;
    color: #a64b08;
    box-shadow: 0 0 0 10px rgb(253 231 209 / 0.45);
  }
  .acceso-ico svg {
    width: 38px;
    height: 38px;
  }
  .acceso :global(.acceso-dato) {
    display: grid;
    justify-items: center;
    margin: 0;
    font-weight: 650;
    font-size: 1.05rem;
    overflow-wrap: anywhere;
  }
  .acceso-nota {
    margin: 0;
    color: var(--suave);
  }
  /* Los dos botones, alineados abajo */
  .acceso :global(.acceso-boton) {
    margin-top: auto;
    min-height: 50px;
    padding: 0 24px;
    gap: 8px;
  }
  #mapa[hidden] {
    display: none;
  }

  .temas {
    margin: 18px 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px 16px;
    font-size: 0.92rem;
    color: var(--suave);
  }
  /* El resto de canales: una fila de íconos */
  .otros {
    max-width: 820px;
    margin: 26px auto 0;
    display: grid;
    justify-items: center;
    gap: 12px;
    text-align: center;
  }
  .otros-titulo {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--suave);
  }
  .otros :global(.atencion) {
    margin: 0;
    display: inline-flex;
    gap: 6px;
    align-items: baseline;
    font-size: 0.88rem;
    color: var(--suave);
  }
  .otros :global(.atencion .dt) {
    font-size: 0.72rem;
  }
</style>
