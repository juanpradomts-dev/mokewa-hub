---
import Dato from "../components/Dato.astro";
import Base from "../layouts/Base.astro";
import BotonContacto from "../components/BotonContacto.astro";
import club from "../data/club.json";
import { valor } from "../lib/contenido.js";
---

<Base titulo="Contacto" seccion="contacto" descripcion="Contacto del Ajedrez Club Mokewa en Moquegua: clases, torneos, sede y redes.">
  <section class="seccion cabeza">
    <div class="contenedor">
      <p class="antetitulo">Contacto</p>
      <h1>Hablemos</h1>
      <p class="bajada">Escríbenos y te contamos horarios, niveles y cómo empezar.</p>

      <div class="rejilla rejilla-2 contacto">
        <div class="tarjeta">
          <h2 class="h-bloque">Escríbenos</h2>
          <Dato como="p" etiqueta="WhatsApp" campo="whatsapp" />
          <div class="grupo-botones">
            <BotonContacto variante="primario" accion="Preguntar por clases" mensaje="Hola, quisiera información sobre las clases de ajedrez." />
            <BotonContacto variante="secundario" accion="Preguntar por torneos" mensaje="Hola, tengo una consulta sobre un torneo del club." />
          </div>
        </div>
        <div class="tarjeta">
          <h2 class="h-bloque">Sede</h2>
          <Dato como="p" etiqueta="Dirección" campo="sede" />
          <Dato como="p" etiqueta="Horario de atención" campo="atencion" />
          <a class="boton boton-secundario" id="mapa" data-si-campos="mapa" hidden={!valor("mapa")} href={valor("mapa") ?? "#"} rel="noopener" target="_blank">Ver en Google Maps</a>
        </div>
        <div class="tarjeta">
          <h2 class="h-bloque">Redes</h2>
          <ul class="redes">
            <li><a href="https://www.facebook.com/ACMokewa/" rel="noopener" target="_blank">Facebook · ACMokewa</a></li>
            <li><a href={club.equipo.url} rel="noopener" target="_blank">Lichess · equipo {club.equipo.nombre}</a></li>
            <Dato como="li" etiqueta="Correo" campo="correo" />
          </ul>
        </div>
        <div class="tarjeta">
          <h2 class="h-bloque">Colegios y empresas</h2>
          <p>Talleres escolares, torneos intercolegiales, delegaciones y patrocinio.</p>
          <BotonContacto variante="secundario" accion="Escribir al club" mensaje="Hola, escribo de un colegio/empresa y quisiera información sobre talleres o patrocinio." />
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { contenido, alCambiar } from "../lib/store.js";
  const mapa = document.getElementById("mapa") as HTMLAnchorElement;
  const pintar = () => {
    const m = contenido("mapa");
    if (m && /^https:\/\//.test(m)) mapa.href = m;
    mapa.hidden = !(m && /^https:\/\//.test(m));
  };
  pintar();
  alCambiar(pintar);
</script>

<style>
  .cabeza {
    background: linear-gradient(180deg, #fde7d1, var(--fondo) 60%);
  }
  #mapa[hidden] {
    display: none;
  }
  .contacto {
    margin-top: 24px;
  }
  .h-bloque {
    font-size: 1.3rem;
  }
  .suave {
    color: var(--suave);
    font-size: 0.9rem;
    margin: 12px 0 0;
  }
  .redes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
</style>
