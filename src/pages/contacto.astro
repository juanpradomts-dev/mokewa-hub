---
// Contacto: dos accesos claros. Escribir (el Gmail del club es el canal principal; mientras falte,
// WhatsApp o Facebook) y llegar (dirección de la sede y Google Maps). Lo demás va en pequeño.
import Dato from "../components/Dato.astro";
import Base from "../layouts/Base.astro";
import BotonContacto from "../components/BotonContacto.astro";
import club from "../data/club.json";
import { valor, esProduccion } from "../lib/contenido.js";
import { enlaceContacto } from "../lib/contacto.js";

// Los textos dicen por dónde responde el club de verdad: Gmail, WhatsApp o, mientras falten, Facebook.
const POR = { correo: "por correo", whatsapp: "por WhatsApp", facebook: "por mensaje en Facebook" };
const TITULO = { correo: "Correo", whatsapp: "WhatsApp", facebook: "Mensaje directo" };
const canal = enlaceContacto({ correo: valor("correo"), whatsapp: valor("whatsapp") }).tipo;
const mapa = valor("mapa");
const conSede = !!valor("sede") || !esProduccion;
---

<Base titulo="Contacto" seccion="contacto" descripcion="Contacto del Ajedrez Club Mokewa en Moquegua: correo, dirección de la sede y cómo llegar.">
  <section class="seccion cabeza">
    <div class="contenedor">
      <div class="principal">
        <p class="antetitulo">Contacto</p>
        <h1>Hablemos</h1>
        <p class="bajada">Pregúntanos por horarios, precios o cómo empezar.</p>

        <div class:list={["accesos", { solo: !conSede }]}>
          <article class="acceso">
            <span class="acceso-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M3 5.5h18v13H3z M3.5 6l8.5 7 8.5-7"></path></svg>
            </span>
            <h2 data-titulo-canal>{TITULO[canal]}</h2>
            <Dato como="p" clase="acceso-dato" etiqueta="Gmail del club" campo="correo" />
            <p class="acceso-nota">Te respondemos <span data-por>{POR[canal]}</span>.</p>
            <BotonContacto variante="primario" clase="acceso-boton" mensaje="Hola, quisiera información sobre las clases de ajedrez." />
          </article>

          {conSede && (
            <article class="acceso">
              <span class="mini-mapa" aria-hidden="true">
                <svg viewBox="0 0 240 110" preserveAspectRatio="xMidYMid slice">
                  <rect width="240" height="110" fill="#fde7d1"></rect>
                  <rect x="18" y="14" width="64" height="34" rx="6" fill="#f9d3ae"></rect>
                  <rect x="18" y="62" width="64" height="34" rx="6" fill="#f9d3ae"></rect>
                  <rect x="158" y="14" width="64" height="34" rx="6" fill="#f9d3ae"></rect>
                  <rect x="158" y="62" width="64" height="34" rx="6" fill="#e6dcc4"></rect>
                  <path d="M0 55h240M120 0v110" stroke="#fff" stroke-width="12"></path>
                  <path d="M0 55h240M120 0v110" stroke="#f3c79c" stroke-width="1.5" stroke-dasharray="6 6"></path>
                  <path d="M96 0l48 110" stroke="#fff" stroke-width="7"></path>
                </svg>
                <span class="pin">
                  <svg viewBox="0 0 24 32"><path d="M12 31s10-11.2 10-18.5C22 6.2 17.5 2 12 2S2 6.2 2 12.5C2 19.8 12 31 12 31Z" fill="#f28a1e" stroke="#1a1714" stroke-width="2"></path><circle cx="12" cy="12.5" r="4" fill="#fff"></circle></svg>
                </span>
              </span>
              <h2>Dónde estamos</h2>
              <Dato como="p" clase="acceso-dato" etiqueta="Sede del club" campo="sede" />
              <a class="boton boton-secundario acceso-boton" id="mapa" data-si-campos="mapa" hidden={!mapa} href={mapa ?? "#"} rel="noopener" target="_blank">
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"></path></svg>
                Cómo llegar
              </a>
            </article>
          )}
        </div>

        <p class="temas">
          ¿Otra consulta?
          <BotonContacto variante="texto" accion="Torneos" mensaje="Hola, tengo una consulta sobre un torneo del club." />
          <BotonContacto variante="texto" accion="Colegios y empresas" mensaje="Hola, escribo de un colegio o empresa y quisiera información sobre talleres, torneos o patrocinio." />
        </p>
      </div>

      <ul class="otros">
        <li data-canal="whatsapp" hidden={canal === "whatsapp"}><Dato etiqueta="WhatsApp" campo="whatsapp" /></li>
        <li data-canal="facebook" hidden={canal === "facebook"}><a href="https://www.facebook.com/ACMokewa/" rel="noopener" target="_blank">Facebook</a></li>
        <li><a href={club.equipo.url} rel="noopener" target="_blank">Equipo en Lichess</a></li>
        <li><Dato etiqueta="Atención" campo="atencion" /></li>
      </ul>
    </div>
  </section>
</Base>

<script>
  import { contenido, alCambiar } from "../lib/store.js";
  import { enlaceContacto } from "../lib/contacto.js";
  const POR: Record<string, string> = { correo: "por correo", whatsapp: "por WhatsApp", facebook: "por mensaje en Facebook" };
  const TITULO: Record<string, string> = { correo: "Correo", whatsapp: "WhatsApp", facebook: "Mensaje directo" };
  const mapa = document.getElementById("mapa") as HTMLAnchorElement | null;
  const pintar = () => {
    // El canal principal no se repite en la lista pequeña.
    const { tipo } = enlaceContacto({ correo: contenido("correo"), whatsapp: contenido("whatsapp") });
    document.querySelector("[data-por]")!.textContent = POR[tipo];
    document.querySelector("[data-titulo-canal]")!.textContent = TITULO[tipo];
    for (const li of document.querySelectorAll<HTMLElement>("[data-canal]")) li.hidden = li.dataset.canal === tipo;
    if (!mapa) return;
    const m = contenido("mapa");
    if (m && /^https:\/\//.test(m)) mapa.href = m;
    mapa.hidden = !(m && /^https:\/\//.test(m));
  };
  pintar();
  alCambiar(pintar);
</script>

<style>
  .cabeza {
    background: linear-gradient(180deg, #fde7d1, var(--fondo) 70%);
  }
  .principal {
    position: relative;
    max-width: 820px;
    margin: 8px auto 0;
    padding: clamp(28px, 6vw, 48px) clamp(16px, 5vw, 44px);
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: 22px;
    box-shadow: var(--sombra);
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 6px;
    overflow: hidden;
  }
  /* Borde superior de tablero */
  .principal::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 10px;
    background: conic-gradient(#f28a1e 25%, #1a1714 0 50%, #f28a1e 0 75%, #1a1714 0) 0 0 / 20px 20px;
  }
  .principal :global(.antetitulo) {
    justify-content: center;
    margin-top: 6px;
  }
  .principal h1 {
    margin: 0;
  }
  .principal .bajada {
    margin: 0 auto 14px;
    max-width: 46ch;
  }

  /* Los dos accesos: escribir y llegar */
  .accesos {
    width: 100%;
    display: grid;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .accesos {
      grid-template-columns: 1fr 1fr;
    }
    .accesos.solo {
      grid-template-columns: minmax(0, 380px);
      justify-content: center;
    }
  }
  .acceso {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 22px 18px 20px;
    border-radius: 18px;
    background: #fffaf4;
    border: 1px solid var(--linea);
    transition:
      transform 0.25s,
      box-shadow 0.25s;
  }
  .acceso:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 28px rgb(90 42 6 / 0.12);
  }
  .acceso h2 {
    margin: 2px 0 0;
    font-size: 1.35rem;
  }
  .acceso-ico {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #fde7d1;
    color: #a64b08;
  }
  .acceso-ico svg {
    width: 30px;
    height: 30px;
  }
  .acceso :global(.acceso-dato) {
    display: grid;
    justify-items: center;
    margin: 0;
    font-weight: 650;
    font-size: 1.05rem;
    overflow-wrap: anywhere;
  }
  .acceso-nota {
    margin: 0;
    color: var(--suave);
  }
  /* Los dos botones, alineados abajo */
  .acceso :global(.acceso-boton) {
    margin-top: auto;
    min-height: 50px;
    padding: 0 24px;
    gap: 8px;
  }
  #mapa[hidden] {
    display: none;
  }

  /* Mini mapa ilustrado (decorativo) con el pin que rebota */
  .mini-mapa {
    position: relative;
    display: block;
    width: 100%;
    max-width: 260px;
    height: 64px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--linea);
  }
  .mini-mapa > svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .pin {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 24px;
    height: 32px;
    translate: -50% -88%;
    animation: pin 1.8s ease-in-out infinite;
  }
  .pin svg {
    display: block;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 3px 2px rgb(90 42 6 / 0.35));
  }
  @keyframes pin {
    50% {
      transform: translateY(-5px);
    }
  }

  .temas {
    margin: 18px 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 4px 8px;
    font-size: 0.92rem;
    color: var(--suave);
  }
  /* El resto de canales, en pequeño */
  .otros {
    list-style: none;
    max-width: 820px;
    margin: 18px auto 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 18px;
    font-size: 0.88rem;
    color: var(--suave);
  }
  .otros :global(.dato) {
    display: inline-flex;
    gap: 6px;
    align-items: baseline;
  }
  .otros :global(.dt) {
    font-size: 0.72rem;
  }
  .otros li[hidden],
  .otros li:empty {
    display: none;
  }
</style>
