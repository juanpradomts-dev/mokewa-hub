---
import Base from "../layouts/Base.astro";
const b = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base titulo="Página no encontrada">
  <section class="seccion">
    <div class="contenedor" style="max-width:640px">
      <p class="antetitulo">Error 404</p>
      <h1>Esa jugada no existe</h1>
      <p class="bajada">La página que buscas no está aquí. Vuelve al inicio o busca tus títulos en el Salón de la Fama.</p>
      <div class="grupo-botones">
        <a class="boton boton-primario" href={`${b}/`}>Ir al inicio</a>
        <a class="boton boton-secundario" href={`${b}/salon-de-la-fama/`}>Salón de la Fama</a>
      </div>
    </div>
  </section>
</Base>
